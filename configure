#!/usr/bin/env sh

DIR_RES="./src/xtcore/res/"
OUT_LICENSE="$DIR_RES/license.h"
mkdir -p $DIR_RES
xxd -i ./LICENSE | sed 's/unsigned char/const char/g' | sed 's/\([0-9a-f]\)$/\0, 0x00/' > $OUT_LICENSE
BUILD=${BUILD:-Debug}
XTRACER_ENABLE_RTMIDI=${XTRACER_ENABLE_RTMIDI:-ON}
make -C ./automation
cmake -S . -B . \
    -DCMAKE_BUILD_TYPE="$BUILD" \
    -DXTRACER_ENABLE_RTMIDI="$XTRACER_ENABLE_RTMIDI"
