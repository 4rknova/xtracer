_xtracer_cli_complete()
{
    local cur prev opts renderers
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="-renderer -threads -res -rdepth -samples -tile_size -aa -cam -outdir -mod"
    renderers="raytracer pathtracer pathtracer_mis pathtracer_is pathtracer_mis_full photon_mapping ao debug_views depth stencil normal uv emission"

    case "${prev}" in
        -renderer)
            COMPREPLY=( $(compgen -W "${renderers}" -- "${cur}") )
            return 0
            ;;
        -cam|-outdir|-mod|-res|-threads|-rdepth|-samples|-tile_size|-aa)
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
        return 0
    fi

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "version" -- "${cur}") )
        return 0
    fi

    COMPREPLY=( $(compgen -f -X '!*.scn' -- "${cur}") )
    return 0
}

_xtracer_web_complete()
{
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="--host --port --scene-dir --web-root --verbose --help -v"

    case "${prev}" in
        --host|--port|--scene-dir|--web-root)
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    fi
    return 0
}

complete -F _xtracer_cli_complete xtracer_cli
complete -F _xtracer_web_complete xtracer_web
