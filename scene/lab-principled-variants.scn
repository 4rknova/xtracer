title = Principled Material Variants Lab
description = Variant-driven showcase for principled GGX materials across dielectric, metallic, and roughness regimes.
version = 1.0
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction = vec3(-0.3,0.82,-0.48)
        sun_intensity = col3(14,13,11)
        beta_rayleigh = col3(0.18,0.34,0.78)
        ground_color = col3(0.05,0.05,0.06)
        density = 1.0
        horizon_falloff = 1.6
        sun_disk_radius = 1.0
        sun_disk_intensity = 1.2
        sun_glow_radius = 8.0
        sun_glow_intensity = 0.22
        sun_glow_falloff = 3.0
    }
}

camera = {
    hero = {
        type = thin-lens
        fov = 38
        position = vec3(0.0,2.5,-6.8)
        target = vec3(0.0,0.8,2.5)
        up = vec3(0,1,0)
        flength = 45
        aperture = 0
    }

    close = {
        type = thin-lens
        fov = 28
        position = vec3(-1.2,1.7,-7.0)
        target = vec3(0.2,0.9,2.6)
        up = vec3(0,1,0)
        flength = 55
        aperture = 0
    }
}

geometry = {
    ground = {
        type = plane
        normal = vec3(0,1,0)
        distance = -1.0
    }

    back_wall = {
        type = plane
        normal = vec3(0,0,-1)
        distance = -8.0
    }

    left_sphere = {
        type = sphere
        position = vec3(-3.1,0.1,2.7)
        radius = 1.1
    }

    center_sphere = {
        type = sphere
        position = vec3(0.0,0.1,2.7)
        radius = 1.1
    }

    right_sphere = {
        type = sphere
        position = vec3(3.1,0.1,2.7)
        radius = 1.1
    }

    center_form = {
        type = mesh
        source = gen(icosahedron)
        modifiers = {
            scale = vec3(1.3,1.3,1.3)
            rotation = vec3(0,28,0)
            translation = vec3(0.0,0.9,5.6)
        }
    }

    key_light = {
        type = sphere
        position = vec3(-4.5,5.8,-0.2)
        radius = 0.7
    }

    rim_light = {
        type = sphere
        position = vec3(5.0,3.8,1.0)
        radius = 0.45
    }
}

material = {
    ground_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type = graphpaper
                    base = col3(0.74,0.75,0.77)
                    minor = col3(0.63,0.65,0.70)
                    major = col3(0.50,0.53,0.58)
                    scale = 8
                    major_every = 4
                    minor_width = 0.035
                    major_width = 0.07
                }
            }
        }
    }

    back_wall_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type = color
                    value = col3(0.82,0.84,0.88)
                }
            }
        }
    }

    ceramic_soft = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.82,0.30,0.24)
                }
            }
            scalars = {
                metallic = 0.0
                roughness = 0.48
                ior = 1.5
                clearcoat = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    paint_gloss = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.16,0.34,0.86)
                }
            }
            scalars = {
                metallic = 0.0
                roughness = 0.12
                ior = 1.5
                clearcoat = 0.9
                clearcoat_roughness = 0.05
            }
        }
    }

    paint_gloss_relief = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.16,0.34,0.86)
                }
                normal = {
                    type = voronoi_normal
                    cells = 220
                    max_deviation = 12
                    seed = 41
                }
            }
            scalars = {
                metallic = 0.0
                roughness = 0.12
                ior = 1.5
                clearcoat = 0.95
                clearcoat_roughness = 0.05
            }
        }
    }

    gold_brushed = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.93,0.73,0.24)
                }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.22
                anisotropy = 0.82
                anisotropy_rotation = 28
                ior = 1.5
                clearcoat = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    chrome_brushed = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.90,0.92,0.95)
                }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.18
                anisotropy = 0.9
                anisotropy_rotation = -36
                ior = 1.5
                clearcoat = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    chrome_sharp = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = color
                    value = col3(0.90,0.92,0.95)
                }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.06
                ior = 1.5
                clearcoat = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    plastic_rough = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = weave
                    base = col3(0.10,0.11,0.13)
                    warp = col3(0.80,0.32,0.18)
                    weft = col3(0.16,0.20,0.26)
                    scale = 10
                    band_width = 0.60
                }
                roughness = {
                    type = checker
                    a = col3(0.82,0.82,0.82)
                    b = col3(0.36,0.36,0.36)
                    scale_u = 6
                    scale_v = 6
                }
            }
            scalars = {
                metallic = 0.0
                roughness = 0.62
                ior = 1.48
                clearcoat = 0.35
                clearcoat_roughness = 0.12
            }
        }
    }

    copper_aged = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type = fbm_marble
                    a = col3(0.54,0.30,0.18)
                    b = col3(0.25,0.18,0.14)
                    vein = col3(0.10,0.30,0.24)
                    scale = 4.8
                    vein_frequency = 8.0
                    turbulence = 3.5
                    octaves = 5
                    lacunarity = 2.0
                    gain = 0.5
                    vein_strength = 0.6
                    vein_sharpness = 3.4
                }
                metallic = {
                    type = checker
                    a = col3(0.95,0.95,0.95)
                    b = col3(0.68,0.68,0.68)
                    scale_u = 5
                    scale_v = 5
                }
                roughness = {
                    type = graphpaper
                    base = col3(0.30,0.30,0.30)
                    minor = col3(0.48,0.48,0.48)
                    major = col3(0.70,0.70,0.70)
                    scale = 7
                    major_every = 4
                    minor_width = 0.03
                    major_width = 0.06
                }
            }
            scalars = {
                metallic = 0.92
                roughness = 0.42
                ior = 1.5
                clearcoat = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    key_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type = color
                    value = col3(40,34,28)
                }
            }
        }
    }

    rim_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type = color
                    value = col3(8,12,18)
                }
            }
        }
    }
}

object = {
    ground = { geometry = ground, material = ground_mat }
    back_wall = { geometry = back_wall, material = back_wall_mat }
    left = { geometry = left_sphere, material = ceramic_soft }
    center = { geometry = center_sphere, material = paint_gloss }
    right = { geometry = right_sphere, material = gold_brushed }
    rear_form = { geometry = center_form, material = chrome_sharp }
    key_light = { geometry = key_light, material = key_light_mat }
    rim_light = { geometry = rim_light, material = rim_light_mat }
}

variants = {
    base = {
        name = Base
        description = Balanced principled lineup with ceramic, glossy paint, gold, and chrome.
    }

    roughness_sweep = {
        name = Roughness Sweep
        description = Pushes the lineup toward broad glossy lobes and softer reflections.
        set = {
            object = {
                left = { geometry = left_sphere, material = plastic_rough }
                center = { geometry = center_sphere, material = ceramic_soft }
                right = { geometry = right_sphere, material = copper_aged }
                rear_form = { geometry = center_form, material = gold_brushed }
            }
        }
    }

    metallic_read = {
        name = Metallic Read
        description = Concentrates on conductor response with chrome, copper, and gold in one frame.
        set = {
            default_camera = close
            object = {
                left = { geometry = left_sphere, material = chrome_sharp }
                center = { geometry = center_sphere, material = copper_aged }
                right = { geometry = right_sphere, material = gold_brushed }
                rear_form = { geometry = center_form, material = paint_gloss }
            }
        }
    }

    coated_finish = {
        name = Coated Finish
        description = Pushes the painted and plastic objects into a stronger coated finish regime.
        set = {
            object = {
                left = { geometry = left_sphere, material = ceramic_soft }
                center = { geometry = center_sphere, material = paint_gloss }
                right = { geometry = right_sphere, material = plastic_rough }
                rear_form = { geometry = center_form, material = chrome_sharp }
            }
        }
    }

    normal_mapped = {
        name = Normal Mapped
        description = Uses procedural normal relief on the coated paint to show highlight breakup on the principled path.
        set = {
            object = {
                left = { geometry = left_sphere, material = ceramic_soft }
                center = { geometry = center_sphere, material = paint_gloss_relief }
                right = { geometry = right_sphere, material = gold_brushed }
                rear_form = { geometry = center_form, material = chrome_sharp }
            }
        }
    }

    anisotropic = {
        name = Anisotropic
        description = Uses brushed-metal anisotropy to stretch the specular response on the conductor lineup.
        set = {
            default_camera = close
            object = {
                left = { geometry = left_sphere, material = chrome_brushed }
                center = { geometry = center_sphere, material = gold_brushed }
                right = { geometry = right_sphere, material = copper_aged }
                rear_form = { geometry = center_form, material = chrome_sharp }
            }
        }
    }

    anisotropic_rotated = {
        name = Anisotropic Rotated
        description = Rotates brushed direction on the metal lineup to verify artist control over anisotropy orientation.
        set = {
            default_camera = close
            object = {
                left = { geometry = left_sphere, material = gold_brushed }
                center = { geometry = center_sphere, material = chrome_brushed }
                right = { geometry = right_sphere, material = gold_brushed }
                rear_form = { geometry = center_form, material = copper_aged }
            }
        }
    }
}
