title = Procedural Sierpinski Tetrahedron Showcase
description = Demonstrates gen(sierpinski_tetrahedron) with adjustable subdivision depth via resolution.
version = 1.0

tetra_resolution = 3

environment = {
    type = gradient
    config = {
        a = col3(0.90,0.93,0.98)
        b = col3(0.10,0.11,0.15)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 45
        position = vec3(0,3,-5)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(50,1,50)
            translation = vec3(0,-1.5,0)
        }
    }

    sierpinski_main_gen = {
        type       = mesh
        source     = gen(sierpinski_tetrahedron)
        resolution = <tetra_resolution>
        modifiers = {
            scale        = vec3(2.0,2.0,2.0)
            rotation     = vec3(0,0.7853982,0)
            flip_normals = true
        }
    }

    sierpinski_main_gen_implicit = {
        type       = mesh
        source     = gen(sierpinski_tetrahedron_implicit)
        resolution = <tetra_resolution>
        modifiers = {
            scale        = vec3(2.0,2.0,2.0)
            rotation     = vec3(0,0.7853982,0)
            flip_normals = true
        }
    }

    sierpinski_main_analytic = {
        type       = sierpinski_tetrahedron
        position   = vec3(0,0,0)
        radius     = 1.0
        resolution = <tetra_resolution>
    }

    key_light = {
        type     = sphere
        position = vec3(4.2,6.3,-3.0)
        radius   = 0.85
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.56,0.58,0.62) }
            }
        }
    }

    sierpinski_surface = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.67,0.76,0.88) }
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.0,3.6,3.1) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    key_light = { geometry = key_light, material = emissive_key }
}

variants = {
    hide_base = true

    gen_mesh = {
        name        = Sierpinski - Gen Mesh
        description = Uses mesh generator source = gen(sierpinski_tetrahedron).
        set = {
            object = {
                sierpinski_main = { geometry = sierpinski_main_gen, material = sierpinski_surface }
            }
        }
    }

    gen_implicit = {
        name        = Sierpinski - Gen Implicit Mesh
        description = Uses mesh generator source = gen(sierpinski_tetrahedron_implicit).
        set = {
            object = {
                sierpinski_main = { geometry = sierpinski_main_gen_implicit, material = sierpinski_surface }
            }
        }
    }

    analytic = {
        name        = Sierpinski - Analytic Surface
        description = Uses native analytic geometry.type = sierpinski_tetrahedron.
        set = {
            object = {
                sierpinski_main = { geometry = sierpinski_main_analytic, material = sierpinski_surface }
            }
        }
    }
}
