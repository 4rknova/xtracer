title = RTIOW Part 1 Random Spheres
description = Seeded recreation of Ray Tracing in One Weekend Part 1 random spheres scene.
version = 1.0
default_camera = hero

environment = {
    type = gradient
    config = {
        a = col3(1.0,1.0,1.0)
        b = col3(0.5,0.7,1.0)
    }
}

camera = {
    hero = {
        type     = thin-lens
        fov      = 20
        position = vec3(13,2,3)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
        flength  = 10.0
        aperture = 0.06
    }
}

geometry = {
    ground = {
        type     = sphere
        position = vec3(0,-1000,0)
        radius   = 1000
    }

    center_glass = {
        type     = sphere
        position = vec3(0,1,0)
        radius   = 1.0
    }

    left_diffuse = {
        type     = sphere
        position = vec3(-4,1,0)
        radius   = 1.0
    }

    right_metal = {
        type     = sphere
        position = vec3(4,1,0)
        radius   = 1.0
    }
}

material = {
    ground_lambert = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.5,0.5,0.5) }
            }
        }
    }

    glass = {
        type = dielectric
        properties = {
            scalars = {
                ior          = 1.5
                transparency = 1.0
                reflectance  = 0.04
            }
        }
    }

    left_lambert = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.4,0.2,0.1) }
            }
        }
    }

    right_metal = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.7,0.6,0.5) }
                specular = { type = color, value = col3(0.7,0.6,0.5) }
            }
            scalars = {
                reflectance = 1.0
                exponent    = 1024
            }
        }
    }
}

object = {
    ground = { geometry = ground, material = ground_lambert }
    center = { geometry = center_glass, material = glass }
    left   = { geometry = left_diffuse, material = left_lambert }
    right  = { geometry = right_metal, material = right_metal }
}

random = {
    small_spheres = {
        type = sphere_grid
        seed = 1337

        x_min = -11
        x_max = 11
        z_min = -11
        z_max = 11

        y      = 0.2
        radius = 0.2
        jitter = 0.9

        avoid_center = vec3(4,0.2,0)
        avoid_radius = 0.9

        lambert_ratio    = 0.8
        metal_ratio      = 0.95
        metal_fuzz_min   = 0.0
        metal_fuzz_max   = 0.5
        ior              = 1.5
        glass_reflectance = 0.04

        prefix = rtw_small
    }
}
