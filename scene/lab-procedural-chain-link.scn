title = Procedural Chain Link Showcase
description = Demonstrates gen(chain_link) with count, major_radius, minor_radius, and spacing.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.91,0.94,1.00)
        b = col3(0.10,0.11,0.15)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 40
        position = vec3(0.0,2.0,-9.8)
        target   = vec3(0.0,0.9,1.5)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = 0
    }

    chain = {
        type         = mesh
        source       = gen(chain_link)
        resolution   = 80
        count        = 13
        major_radius = 0.62
        minor_radius = 0.17
        spacing      = 1.00
        spline = {
            p0 = vec3(-6.5,1.3,0.5)
            p1 = vec3(-4.8,1.6,1.4)
            p2 = vec3(-3.2,1.4,2.7)
            p3 = vec3(-1.5,1.0,3.3)
            p4 = vec3(0.2,0.8,3.5)
            p5 = vec3(2.0,0.9,3.0)
            p6 = vec3(3.6,1.3,1.8)
            p7 = vec3(5.0,1.8,0.3)
            p8 = vec3(6.2,2.1,-1.2)
        }
        modifiers = {
            translation = vec3(0,0.2,1.0)
            rotation    = vec3(0,0,0)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(4.2,4.5,-2.8)
        radius   = 0.85
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.56,0.57,0.60) }
            }
        }
    }

    chain_polish = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.63,0.64,0.66) }
                specular = { type = color, value = col3(0.98,0.98,0.98) }
            }
            scalars = {
                exponent    = 144
                reflectance = 0.26
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(3.7,3.2,2.6) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    chain = { geometry = chain, material = chain_polish }
    key_light = { geometry = key_light, material = emissive_key }
}
