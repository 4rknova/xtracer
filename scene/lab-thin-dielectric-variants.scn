title = Thin Dielectric Variants Lab
description = Variant-driven showcase for thin-sheet dielectric transmission on panes and visors.
version = 1.0
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction = vec3(0.18,0.82,-0.54)
        sun_intensity = col3(11,10,9)
        beta_rayleigh = col3(0.17,0.33,0.76)
        ground_color = col3(0.05,0.05,0.06)
        density = 1.0
        horizon_falloff = 1.8
        sun_disk_radius = 1.0
        sun_disk_intensity = 1.2
        sun_glow_radius = 8.0
        sun_glow_intensity = 0.2
        sun_glow_falloff = 3.0
    }
}

camera = {
    hero = {
        type = thin-lens
        fov = 40
        position = vec3(0.0,1.8,-5.0)
        target = vec3(0.0,1.0,3.4)
        up = vec3(0,1,0)
        flength = 50
        aperture = 0
    }

    close = {
        type = thin-lens
        fov = 28
        position = vec3(0.0,1.7,-4.0)
        target = vec3(0.0,1.05,3.7)
        up = vec3(0,1,0)
        flength = 60
        aperture = 0
    }
}

geometry = {
    floor = {
        type = plane
        normal = vec3(0,1,0)
        distance = -1.0
    }

    back_wall = {
        type = plane
        normal = vec3(0,0,-1)
        distance = -7.0
    }

    pane_left = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.2,1.8,1.0)
            translation = vec3(-2.3,1.0,3.2)
            rotation = vec3(0,10,0)
        }
    }

    pane_center = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.2,1.8,1.0)
            translation = vec3(0.0,1.0,3.4)
            rotation = vec3(0,0,0)
        }
    }

    pane_right = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.2,1.8,1.0)
            translation = vec3(2.3,1.0,3.2)
            rotation = vec3(0,-10,0)
        }
    }

    card_left = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,1.8,1.0)
            translation = vec3(-2.3,1.0,5.7)
            rotation = vec3(0,0,0)
        }
    }

    card_center = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,1.8,1.0)
            translation = vec3(0.0,1.0,5.9)
            rotation = vec3(0,0,0)
        }
    }

    card_right = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,1.8,1.0)
            translation = vec3(2.3,1.0,5.7)
            rotation = vec3(0,0,0)
        }
    }

    key_light = {
        type = sphere
        position = vec3(-4.0,5.0,-0.8)
        radius = 0.6
    }
}

material = {
    floor_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type = checker
                    a = col3(0.82,0.84,0.86)
                    b = col3(0.68,0.70,0.73)
                    scale_u = 8
                    scale_v = 8
                }
            }
        }
    }

    wall_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.86,0.89,0.93) }
            }
        }
    }

    card_red = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.92,0.30,0.25) }
            }
        }
    }

    card_green = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.24,0.76,0.52) }
            }
        }
    }

    card_blue = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.24,0.46,0.90) }
            }
        }
    }

    pane_clear = {
        type = thin_dielectric
        properties = {
            samplers = {
                transmission = { type = color, value = col3(1.0,1.0,1.0) }
            }
            scalars = {
                roughness = 0.0
                ior = 1.45
                transparency = 0.98
            }
        }
    }

    pane_soft = {
        type = thin_dielectric
        properties = {
            samplers = {
                transmission = { type = color, value = col3(0.94,0.97,1.0) }
                normal = {
                    type = voronoi_normal
                    cells = 120
                    max_deviation = 6
                    seed = 31
                }
            }
            scalars = {
                roughness = 0.12
                ior = 1.45
                transparency = 0.97
            }
        }
    }

    pane_frost = {
        type = thin_dielectric
        properties = {
            samplers = {
                transmission = { type = color, value = col3(0.90,0.95,1.0) }
            }
            scalars = {
                roughness = 0.28
                ior = 1.45
                transparency = 0.95
            }
        }
    }

    key_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(30,26,22) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_mat }
    wall = { geometry = back_wall, material = wall_mat }
    left = { geometry = pane_left, material = pane_clear }
    center = { geometry = pane_center, material = pane_soft }
    right = { geometry = pane_right, material = pane_frost }
    left_card = { geometry = card_left, material = card_red }
    center_card = { geometry = card_center, material = card_green }
    right_card = { geometry = card_right, material = card_blue }
    key_light = { geometry = key_light, material = key_light_mat }
}

variants = {
    base = {
        name = Base
        description = Thin-sheet panes progress from clear to softly frosted without solid-glass refraction.
    }

    all_clear = {
        name = All Clear
        description = Uses mostly clear thin dielectric to check the straight-through sheet look.
        set = {
            object = {
                left = { geometry = pane_left, material = pane_clear }
                center = { geometry = pane_center, material = pane_clear }
                right = { geometry = pane_right, material = pane_soft }
            }
        }
    }

    frosted = {
        name = Frosted
        description = Pushes all panes toward broader thin-sheet blur for privacy-glass style reads.
        set = {
            default_camera = close
            object = {
                left = { geometry = pane_left, material = pane_soft }
                center = { geometry = pane_center, material = pane_frost }
                right = { geometry = pane_right, material = pane_frost }
            }
        }
    }
}
