title = Sheen Variants Lab
description = Variant-driven cloth-like sheen showcase using draped strips instead of spheres for stronger grazing reads.
version = 1.0
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction = vec3(0.28,0.76,-0.58)
        sun_intensity = col3(10,9,8)
        beta_rayleigh = col3(0.17,0.31,0.72)
        ground_color = col3(0.06,0.07,0.08)
        density = 1.0
        horizon_falloff = 1.7
        sun_disk_radius = 1.0
        sun_disk_intensity = 1.0
        sun_glow_radius = 7.0
        sun_glow_intensity = 0.14
        sun_glow_falloff = 3.0
    }
}

camera = {
    hero = {
        type = thin-lens
        fov = 32
        position = vec3(0.0,1.15,-5.8)
        target = vec3(0.0,0.55,2.9)
        up = vec3(0,1,0)
        flength = 62
        aperture = 0
    }

    low = {
        type = thin-lens
        fov = 26
        position = vec3(0.0,0.72,-4.9)
        target = vec3(0.0,0.42,2.9)
        up = vec3(0,1,0)
        flength = 72
        aperture = 0
    }
}

geometry = {
    floor = { type = plane, normal = vec3(0,1,0), distance = -1.0 }
    back_wall = { type = plane, normal = vec3(0,0,-1), distance = -6.4 }

    left_strip = {
        type = mesh
        source = gen(draped_cloth_strip)
        resolution = 72
        dimensions = vec3(1.8,0.75,2.8)
        folds = 2.4
        edge_lift = 0.26
        curl = 0.18
        taper = 0.16
        sway = -0.18
        asymmetry = -0.22
        pinned = 0.62
        modifiers = {
            translation = vec3(-2.65,-0.12,2.55)
            rotation = vec3(0,-28,0)
        }
    }

    center_strip = {
        type = mesh
        source = gen(draped_cloth_strip)
        resolution = 84
        dimensions = vec3(2.0,0.95,3.1)
        folds = 3.2
        edge_lift = 0.14
        curl = 0.34
        taper = 0.08
        sway = 0.10
        asymmetry = 0.12
        pinned = 0.70
        modifiers = {
            translation = vec3(0.0,-0.08,2.95)
            rotation = vec3(0,6,0)
        }
    }

    right_strip = {
        type = mesh
        source = gen(draped_cloth_strip)
        resolution = 72
        dimensions = vec3(1.8,0.72,2.8)
        folds = 2.2
        edge_lift = 0.18
        curl = -0.12
        taper = 0.22
        sway = 0.26
        asymmetry = 0.28
        pinned = 0.48
        modifiers = {
            translation = vec3(2.75,-0.10,2.6)
            rotation = vec3(0,31,0)
        }
    }

    rim_light = { type = sphere, position = vec3(-2.4,2.8,-0.8), radius = 0.45 }
}

material = {
    floor_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type = checker
                    a = col3(0.80,0.81,0.82)
                    b = col3(0.68,0.69,0.70)
                    scale_u = 9
                    scale_v = 9
                }
            }
        }
    }

    wall_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.88,0.90,0.93) }
            }
        }
    }

    velvet_warm = {
        type = sheen
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.42,0.14,0.10) }
                sheen_color = { type = color, value = col3(0.94,0.62,0.42) }
                normal = { type = voronoi_normal, cells = 24, max_deviation = 4, seed = 21 }
            }
            scalars = {
                sheen = 0.55
            }
        }
    }

    velvet_rose = {
        type = sheen
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.30,0.12,0.20) }
                sheen_color = { type = color, value = col3(0.98,0.52,0.66) }
                normal = { type = voronoi_normal, cells = 30, max_deviation = 5, seed = 23 }
            }
            scalars = {
                sheen = 0.78
            }
        }
    }

    velvet_olive = {
        type = sheen
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.18,0.24,0.12) }
                sheen_color = { type = color, value = col3(0.76,0.90,0.44) }
                normal = { type = voronoi_normal, cells = 28, max_deviation = 4, seed = 25 }
            }
            scalars = {
                sheen = 0.90
            }
        }
    }

    rim_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(26,22,18) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_mat }
    wall = { geometry = back_wall, material = wall_mat }
    left = { geometry = left_strip, material = velvet_warm }
    center = { geometry = center_strip, material = velvet_rose }
    right = { geometry = right_strip, material = velvet_olive }
    rim_light = { geometry = rim_light, material = rim_light_mat }
}

variants = {
    base = {
        name = Base
        description = Warm, rose, and olive cloth-like sheen materials on separated draped strips with stronger side-facing grazing read.
    }

    high_sheen = {
        name = High Sheen
        description = Pushes all three materials toward stronger edge tint for comparison.
        set = {
            object = {
                left = { geometry = left_strip, material = velvet_rose }
                center = { geometry = center_strip, material = velvet_olive }
                right = { geometry = right_strip, material = velvet_olive }
            }
        }
    }

    low_angle = {
        name = Low Angle
        description = Uses a lower camera to exaggerate the grazing-angle sheen response across the lifted strip edges.
        set = {
            default_camera = low
        }
    }
}
