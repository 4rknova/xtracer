title = Subsurface Variants Lab
description = Variant-driven showcase for warm, jade, and stronger backlit subsurface reads.
version = 1.0
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction = vec3(-0.38,0.72,-0.56)
        sun_intensity = col3(10,9,8)
        beta_rayleigh = col3(0.17,0.32,0.74)
        ground_color = col3(0.08,0.09,0.10)
        density = 1.05
        horizon_falloff = 1.6
        sun_disk_radius = 1.0
        sun_disk_intensity = 1.0
        sun_glow_radius = 7.0
        sun_glow_intensity = 0.16
        sun_glow_falloff = 3.0
    }
}

camera = {
    hero = {
        type = thin-lens
        fov = 38
        position = vec3(0.0,1.7,-5.6)
        target = vec3(0.0,1.0,2.8)
        up = vec3(0,1,0)
        flength = 55
        aperture = 0
    }

    close = {
        type = thin-lens
        fov = 30
        position = vec3(0.0,1.6,-4.4)
        target = vec3(0.0,1.0,2.8)
        up = vec3(0,1,0)
        flength = 70
        aperture = 0
    }
}

geometry = {
    floor = {
        type = plane
        normal = vec3(0,1,0)
        distance = -1.0
    }

    back_wall = {
        type = plane
        normal = vec3(0,0,-1)
        distance = -6.8
    }

    left_sphere = {
        type = sphere
        position = vec3(-2.0,0.0,2.8)
        radius = 1.0
    }

    center_sphere = {
        type = sphere
        position = vec3(0.0,0.0,3.0)
        radius = 1.0
    }

    right_sphere = {
        type = sphere
        position = vec3(2.0,0.0,2.8)
        radius = 1.0
    }

    card_left = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,2.2,1.0)
            translation = vec3(-2.0,1.0,5.0)
        }
    }

    card_center = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,2.2,1.0)
            translation = vec3(0.0,1.0,5.2)
        }
    }

    card_right = {
        type = mesh
        source = gen(plane)
        modifiers = {
            scale = vec3(1.4,2.2,1.0)
            translation = vec3(2.0,1.0,5.0)
        }
    }

    rim_light = {
        type = sphere
        position = vec3(0.0,3.8,5.8)
        radius = 0.55
    }
}

material = {
    floor_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type = checker
                    a = col3(0.82,0.82,0.80)
                    b = col3(0.70,0.70,0.68)
                    scale_u = 9
                    scale_v = 9
                }
            }
        }
    }

    wall_mat = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.86,0.90,0.94) }
            }
        }
    }

    card_warm = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.92,0.52,0.34) }
            }
        }
    }

    card_amber = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.96,0.72,0.26) }
            }
        }
    }

    card_cool = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.28,0.76,0.66) }
            }
        }
    }

    wax_soft = {
        type = subsurface
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.86,0.68,0.54) }
                subsurface_color = { type = color, value = col3(1.0,0.56,0.38) }
                subsurface_radius = { type = color, value = col3(0.42,0.78,1.24) }
                normal = { type = voronoi_normal, cells = 28, max_deviation = 5, seed = 5 }
            }
            scalars = {
                subsurface = 0.45
                thickness = 0.22
            }
        }
    }

    wax_deep = {
        type = subsurface
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.80,0.53,0.42) }
                subsurface_color = { type = color, value = col3(1.0,0.40,0.26) }
                subsurface_radius = { type = color, value = col3(0.32,0.55,0.94) }
                normal = { type = voronoi_normal, cells = 30, max_deviation = 4, seed = 7 }
            }
            scalars = {
                subsurface = 0.72
                thickness = 0.78
            }
        }
    }

    jade = {
        type = subsurface
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.50,0.72,0.62) }
                subsurface_color = { type = color, value = col3(0.68,0.96,0.78) }
                subsurface_radius = { type = color, value = col3(0.85,0.46,0.24) }
                normal = { type = voronoi_normal, cells = 36, max_deviation = 3, seed = 9 }
            }
            scalars = {
                subsurface = 0.62
                thickness = 0.56
            }
        }
    }

    rim_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(28,22,18) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_mat }
    wall = { geometry = back_wall, material = wall_mat }
    left = { geometry = left_sphere, material = wax_soft }
    center = { geometry = center_sphere, material = wax_deep }
    right = { geometry = right_sphere, material = jade }
    left_card = { geometry = card_left, material = card_warm }
    center_card = { geometry = card_center, material = card_amber }
    right_card = { geometry = card_right, material = card_cool }
    rim_light = { geometry = rim_light, material = rim_light_mat }
}

variants = {
    base = {
        name = Base
        description = Warm wax to cool jade progression with radius-driven color shift and thickness-driven attenuation.
    }

    backlit = {
        name = Backlit
        description = Moves to a tighter framing and pushes all spheres toward stronger scatter to stress edge glow and path length tint.
        set = {
            default_camera = close
            object = {
                left = { geometry = left_sphere, material = wax_deep }
                center = { geometry = center_sphere, material = jade }
                right = { geometry = right_sphere, material = wax_deep }
            }
        }
    }

    warm_wax = {
        name = Warm Wax
        description = Uses warm wax across the set so the change in thickness is easier to compare than the hue shift.
        set = {
            object = {
                left = { geometry = left_sphere, material = wax_soft }
                center = { geometry = center_sphere, material = wax_deep }
                right = { geometry = right_sphere, material = wax_soft }
            }
        }
    }
}
