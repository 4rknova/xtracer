title = Stereographic Icosa Cage Lab
description = Icosa-based isotropic cage with a centered emissive source projecting onto a receiver plane.
version = 1.0

camera = {
    default = {
        type     = thin-lens
        fov      = 36
        position = vec3(0,0,-10)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
        aperture = 0
        flength  = 0
    }
}

geometry = {
    cage = {
        type       = mesh
        source     = gen(icosa_cage)
        resolution = 64
        modifiers = {
            scale = vec3(1.4,1.4,1.4)
        }
    }

    emitter = {
        type     = sphere
        position = vec3(0,0,0)
        radius   = 0.05
    }

    screen = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(20,20,0)
            rotation    = vec3(-90,0,0)
            translation = vec3(0,0,3.1)
        }
    }
}

material = {
    cage = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.78,0.82,0.88)
                }
            }
        }
    }

    screen = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(1,1,1)
                }
            }
        }
    }

    light = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(100,100,100)
                }
            }
        }
    }
}

object = {
    cage = {
        geometry = cage
        material = cage
    }

    screen = {
        geometry = screen
        material = screen
    }

    emitter = {
        geometry = emitter
        material = light
    }
}
