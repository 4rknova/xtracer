title = Empty Scene
descr = A simple empty scene that renders the environment map
versn = 1.0

data         = data
path_cubemap = <data>/image/envmap/hdr

environment = {
    type = gradient
    config = {
        a = col3(1,1,1)
        b = col3(0.5,0.7,1.0)
    }
}

camera = {
    erp = {
        type = erp
    }
}

