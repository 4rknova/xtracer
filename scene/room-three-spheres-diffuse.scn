title = Room Three Spheres Diffuse
description = Three spheres in a room (diffuse, sphere lights).
version     = 0.5

camera = {
	default = {
        type     = thin-lens
		fov      = 45
		position = vec3(0,0,-20)
		up       = vec3(0,1,0)
	}

	side = {
        type     = thin-lens
		fov      = 45
		position = vec3(3,3,-14)
		up       = vec3(0,1,0)
	}
}

geometry = {
	red_ball = {
		type     = sphere
		position = vec3(0.8,-3.05,-1)
		radius   = 0.95
	}

	green_ball = {
		type     = sphere
		position = vec3(3.5,-3.3,3.5)
       	radius   = 0.77
	}

	blue_ball = {
		type     = sphere
		position = vec3(-2.2,-2.45,0.8)
		radius   = 1.55
	}

	floor = {
		type     = plane
		normal   = vec3(0,1,0)
		distance = -4
	}

	ceiling = {
		type     = plane
		normal   = vec3(0,-1,0)
		distance = 4
	}

	back = {
		type     = plane
		normal   = vec3(0,0,-1)
		distance = 5
	}

	left_wall = {
		type     = plane
		normal   = vec3(1,0,0)
		distance = -5
	}

	right_wall = {
		type     = plane
		normal   = vec3(-1,0,0)
		distance = 5
	}

	l0 = {
		type     = sphere
		radius   = 0.25
		position = vec3(0,1.5,-4)
	}
}

object = {
	ball = {
		geometry = red_ball
		material = lambert_red
	}
	green_ball = {
		geometry = green_ball
		material = lambert_green
	}
	blue_ball = {
		geometry = blue_ball
		material = lambert_blue
	}
    floor = {
		geometry = floor
		material = lambert_grey
	}
	ceiling = {
		geometry = ceiling
		material = lambert_grey
	}
    back = {
		geometry = back
		material = lambert_grey
	}
	right_wall = {
		geometry = right_wall
        material = lambert_blue
	}
	left_wall = {
		geometry = left_wall
		material = lambert_green
	}
    light = {
        geometry = l0
        material = light
    }
}

material = {
	lambert_red = {
		type = lambert

        properties = {
            samplers = {
                ambient = {
                    type  = color
                    value = col3(1,0,0)
                }

                diffuse = {
                    type  = color
                    value = col3(1,0,0)
                }
            }
        }
	}

	lambert_green = {
		type = lambert

        properties = {
            samplers = {
                ambient = {
                    type  = color
                    value = col3(0,1,0)
                }
                diffuse = {
                    type = color
                    value = col3(0,1,0)
                }
            }
        }
	}

	lambert_blue = {
		type = lambert

        properties = {
            samplers = {
                ambient = {
                    type  = color
                    value = col3(0.2,0.4,1)
                }
                diffuse = {
                    type = color
                    value = col3(0.2,0.4,1)
                }
            }
        }
	}

	lambert_grey = {
		type = lambert

        properties = {
            samplers = {
                ambient = {
                    type  = color
                    value = col3(.5,.5,.5)
                }
                diffuse = {
                    type = color
                    value = col3(.5,.5,.5)
                }
            }
        }
	}

    light = {
        type = emissive

        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(1,1,1)
                }
            }
        }
    }
}

