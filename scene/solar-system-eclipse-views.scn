title       = Solar System Views
description = The Moon, Sun, and Earth in four configurations — all viewed from Earth's surface at astronomical scale (1 unit = 1 Earth radius = 6 371 km). Moon r=0.2727 at 60.3 units, Sun r=109.2 at 23 483 units; both subtend ~0.53° — matching real eclipse geometry.
version     = 1.0
default_camera = cam

# ---------------------------------------------------------------------
# Environment — clear blue sky.
# sun_direction is the direction *toward* the sun: high in the south-east
# (bearing ~135°, elevation ~50°) giving the Moon — which faces the camera
# from the north-east at 45° elevation — a classic quarter phase.
#
# For earthbound variants the Rayleigh sky IS the light source: bounced
# rays from the Moon that escape toward the sun disc get bright sun-
# coloured radiance, giving correct directional shading with no sun
# sphere needed.  The sun sphere is only added in solar_eclipse where it
# must be a visible, occludable disc.
# ---------------------------------------------------------------------

environment = {
    type = rayleigh_sky
    config = {
        sun_direction      = vec3(0.54, 0.77, -0.34)
        sun_intensity      = col3(14, 11, 8)
        beta_rayleigh      = col3(0.17, 0.33, 0.76)
        ground_color       = col3(0.04, 0.05, 0.06)
        density            = 1.0
        horizon_falloff    = 1.8
        sun_disk_radius    = 0.28
        sun_disk_intensity = 0.3
        sun_glow_radius    = 6.0
        sun_glow_intensity = 0.14
        sun_glow_falloff   = 3.2
    }
}

# ---------------------------------------------------------------------
# Camera — on Earth's surface, always pointed at the Moon (fov=4°).
# Variants that place the Moon at a different position override the
# target (and up vector when looking straight overhead).
# ---------------------------------------------------------------------

camera = {
    cam = {
        type     = thin-lens
        position = vec3(0, 1.001, 0)
        target   = vec3(42.63, 42.63, 0)
        up       = vec3(0, 0, 1)
        fov      = 4
    }
}

# ---------------------------------------------------------------------
# Geometry
#
# Scale: 1 unit = 1 Earth radius (6 371 km)
#
#   Earth                  r = 1.0    at (0, 0, 0)
#   Moon (quarter)         r = 0.2727 at (42.63, 42.63, 0)   — 60.3 units, 45° elevation NE
#   Moon (rise)            r = 0.2727 at (0, 5.25, 60.07)    — 60.3 units, ~5° elevation east
#   Moon (eclipse)         r = 0.2727 at (0, 60.3,  0)       — directly overhead
#   Sun  (eclipse only)    r = 109.2  at (0, 23483, 0)       — directly overhead, aligned
#   Corona (eclipse only)  r = 130.0  at (0, 23483, 0)       — ~0.08° ring beyond sun disc
#
# Both Moon and Sun subtend 2*atan(r/d) ≈ 0.53° → eclipse geometry is correct.
# ---------------------------------------------------------------------

geometry = {
    earth_geo = {
        type     = sphere
        position = vec3(0, 0, 0)
        radius   = 1.0
    }

    moon_std_geo = {
        type     = sphere
        position = vec3(42.63, 42.63, 0)
        radius   = 0.2727
    }

    moon_rise_geo = {
        type     = sphere
        position = vec3(0, 5.25, 60.07)
        radius   = 0.2727
    }

    moon_eclipse_geo = {
        type     = sphere
        position = vec3(0, 60.3, 0)
        radius   = 0.2727
    }

    sun_geo = {
        type     = sphere
        position = vec3(0, 23483, 0)
        radius   = 109.2
    }

    corona_geo = {
        type     = sphere
        position = vec3(0, 23483, 0)
        radius   = 130.0
    }
}

# ---------------------------------------------------------------------
# Materials
# ---------------------------------------------------------------------

material = {

    moon_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type      = texture
                    source    = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color_2k.jpg
                    filtering = bilinear
                }
            }
            scalars = {
                roughness = 0.92
                metallic  = 0.0
            }
        }
    }

    earth_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type      = texture
                    source    = https://assets.science.nasa.gov/content/dam/science/esd/eo/images/bmng/bmng-base/january/world.200401.3x5400x2700.jpg
                    filtering = bilinear
                }
            }
            scalars = {
                roughness = 0.88
                metallic  = 0.0
            }
        }
    }

    # Sun emitter used only in solar_eclipse.
    # Calibrated to match the Rayleigh sky's sun_intensity (col3(14,11,8)).
    # Both the sky disc and this sphere subtend ~0.53°, so equal radiance
    # values produce equal surface illumination.  The sky's sun_disk_intensity
    # (0.3) is an artistic dim on the procedural disc only — the physical
    # sphere is left at the full sun_intensity value.
    sun_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(14, 11, 8)
                }
            }
        }
    }

    corona_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(9, 7, 4)
                }
            }
        }
    }
}

# ---------------------------------------------------------------------
# Base objects — daytime earthbound view.
# No sun sphere: the Rayleigh sky's sun_direction handles illumination.
# No environment = none: the sky legitimately lights the Moon from Earth.
# ---------------------------------------------------------------------

object = {
    earth = { geometry = earth_geo,    material = earth_mat }
    moon  = { geometry = moon_std_geo, material = moon_mat  }
}

# ---------------------------------------------------------------------
# Variants
# ---------------------------------------------------------------------

variants = {

    base = {
        name        = Quarter Moon
        description = The Moon at 45° elevation in a clear daytime sky. The Rayleigh sky sun_direction illuminates the Moon's near-hemisphere, producing a natural quarter phase. Both NASA LRO textures applied; Earth Blue Marble sphere underfoot.
    }

    moon_rise = {
        name        = Moonrise
        description = The Moon cresting the eastern horizon at ~5° elevation. Sun is setting in the west behind the viewer, so we face a nearly full moon. Rayleigh sky set to sunset colours.
        set = {
            camera = {
                cam = {
                    type     = thin-lens
                    position = vec3(0, 1.001, 0)
                    target   = vec3(0, 5.25, 60.07)
                    up       = vec3(0, 1, 0)
                    fov      = 4
                }
            }
            object = {
                moon = { geometry = moon_rise_geo, material = moon_mat }
            }
            # Sun setting due west (-Z): sun_direction points west-ish.
            # The Moon is due east, so its sun-facing hemisphere points
            # toward the camera — nearly full moon at moonrise.
            environment = {
                type = rayleigh_sky
                config = {
                    sun_direction      = vec3(-0.02, 0.04, -0.999)
                    sun_intensity      = col3(26, 15, 6)
                    beta_rayleigh      = col3(0.24, 0.42, 0.90)
                    ground_color       = col3(0.08, 0.06, 0.04)
                    density            = 1.3
                    horizon_falloff    = 1.2
                    sun_disk_radius    = 1.0
                    sun_disk_intensity = 2.2
                    sun_glow_radius    = 14.0
                    sun_glow_intensity = 0.65
                    sun_glow_falloff   = 2.0
                }
            }
        }
    }

    lunar_eclipse = {
        name        = Lunar Eclipse
        description = Total lunar eclipse. Sky is near-black (night); flat red-orange environment provides omnidirectional illumination simulating the refracted sunlight that wraps around Earth's atmospheric limb — no dark side on the Moon disc.
        set = {
            camera = {
                cam = {
                    type     = thin-lens
                    position = vec3(0, 1.001, 0)
                    target   = vec3(0, 60.3, 0)
                    up       = vec3(1, 0, 0)
                    fov      = 4
                }
            }
            object = {
                moon = { geometry = moon_eclipse_geo, material = moon_mat }
            }
            environment = {
                type   = color
                config = { value = col3(1.2, 0.28, 0.10) }
            }
        }
    }

    solar_eclipse = {
        name        = Solar Eclipse — Totality
        description = Total solar eclipse. Moon (r=0.2727 at 60.3 units) exactly occults the Sun (r=109.2 at 23 483 units) — both ~0.53°. Corona sphere (r=130) creates a narrow ring. The Moon has environment = none: in space it is only lit by the sun sphere, not by Earth's atmosphere.
        set = {
            camera = {
                cam = {
                    type     = thin-lens
                    position = vec3(0, 1.001, 0)
                    target   = vec3(0, 60.3, 0)
                    up       = vec3(1, 0, 0)
                    fov      = 4
                }
            }
            environment = {
                type   = color
                config = { value = col3(0.005, 0.005, 0.012) }
            }
            object = {
                moon   = { geometry = moon_eclipse_geo, material = moon_mat, environment = none }
                sun    = { geometry = sun_geo,          material = sun_light_mat }
                corona = { geometry = corona_geo,       material = corona_mat   }
            }
        }
    }
}
