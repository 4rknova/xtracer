    }

    # ── Bourke 07 — bottom half only (CSG) ───────────────────────────

    bourke_07_halved = {
        type = csg
        op   = intersection
        left = {
            type       = quaternion_julia
            position   = vec3(0,0,0)
            radius     = 1.1
            resolution = 14
            quat_cw    = -0.2
            quat_c     = vec3(0.8, 0.0, 0.0)
            quat_w0    = 0.0
            bailout    = 4.0
            orbit_trap = plane_y
        }
        right = {
            type     = plane
            normal   = vec3(0,1,0)
            distance = 0
        }
    }

    # ── Floor and lights ─────────────────────────────────────────────

    floor_geo = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers  = {
            scale       = vec3(40,1,40)
            translation = vec3(0,-1.5,0)
        }
    }

    key_geo = {
        type     = sphere
        position = vec3(4,8,-4)
        radius   = 1.2
    }

    fill_geo = {
        type     = sphere
        position = vec3(-6,3,5)
        radius   = 2.0
    }

    rim_geo = {
        type     = sphere
        position = vec3(0,4,-8)
        radius   = 1.5
    }
}

