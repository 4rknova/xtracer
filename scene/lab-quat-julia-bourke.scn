    # ── CSG cross-section ────────────────────────────────────────────

    bourke_07_interior = {
        name        = Bourke 07 — Bottom half (cross-section)
        description = Preset 07, c=(-0.2, 0.8, 0, 0). CSG clips the fractal at y=0. Camera sits at cut height looking along the slice, so the cut face is edge-on and the fractal surface structure fills the frame.
        set = {
            object = { fractal = { geometry = bourke_07_halved, materials = { a = quat_m0, b = quat_m1, c = quat_m2 } } }
            camera = {
                default = {
                    position        = vec3(0.4,1.0,2.0)
                    target          = vec3(0,-0.1,0)
                    up              = vec3(0,1,0)
