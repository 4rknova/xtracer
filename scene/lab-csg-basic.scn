title       = CSG Basic
description = Basic constructive solid geometry showcase (difference + union).
version     = 1.0

default_camera = cam_main

ambient  = col3(0.08,0.08,0.08)
k_ambient = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.08,0.1,0.14)
        b = col3(0.22,0.24,0.28)
    }
}

camera = {
    cam_main = {
        type     = thin-lens
        fov      = 40
        position = vec3(0,1.2,-5.8)
        target   = vec3(0,0.2,0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    csg_cut_sphere = {
        type = csg
        op   = difference
        left = {
            type     = sphere
            position = vec3(-1.05,0.45,0.4)
            radius   = 0.95
        }
        right = {
            type     = sphere
            position = vec3(-0.58,0.45,0.42)
            radius   = 0.62
        }
    }

    csg_capsule_like = {
        type = csg
        op   = union
        left = {
            type     = sphere
            position = vec3(1.0,0.25,0.25)
            radius   = 0.78
        }
        right = {
            type     = sphere
            position = vec3(1.0,-0.45,0.25)
            radius   = 0.78
        }
    }

    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -1
    }
}

material = {
    mat_csg_a = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.93,0.74,0.36) }
                ambient = { type = color, value = col3(0.93,0.74,0.36) }
            }
        }
    }

    mat_csg_b = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.36,0.78,0.92) }
                ambient = { type = color, value = col3(0.36,0.78,0.92) }
            }
        }
    }

    mat_floor = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.28,0.28,0.3) }
                ambient = { type = color, value = col3(0.28,0.28,0.3) }
            }
        }
    }
}

object = {
    obj_cut_sphere = { geometry = csg_cut_sphere, material = mat_csg_a }
    obj_capsule_like = { geometry = csg_capsule_like, material = mat_csg_b }
    obj_floor = { geometry = floor, material = mat_floor }
}
