title       = "Dark Low-Poly Terrain"
description = "Moody, minimal low-poly mountain landscape in near-black tones with subtle facet shading"
version     = "1.0"

environment = {
    type   = color
    config = { value = col3(0.008, 0.008, 0.012) }
}

camera = {
    default = {
        type     = thin-lens
        position = vec3(0, 5, -9)
        target   = vec3(4, 4, -6)
        up       = vec3(0, 1, 0)
        fov      = 60
    }
}

geometry = {
    terrain = {
        type       = mesh
        source     = gen(lowpoly_terrain)
        resolution = 100
        dimensions = vec3(100, 5, 100)
        height_sampler = {
            type              = scenery_heightfield
            seed              = 4102
            scale             = 1
            octaves           = 6
            lacunarity        = 5.15
            gain              = 5.50
            ridge_strength    = 0.88
            mountain_strength = 0.92
            valley_strength   = 0.62
        }
        modifiers  = {
            translate = vec3(0, -0.6, 3)
        }
    }
    key_geo  = { type = sphere, position = vec3(-10,  9,  10), radius = 1.8 }
    fill_geo = { type = sphere, position = vec3(  8,  5,  -4), radius = 1.2 }
    rim_geo  = { type = sphere, position = vec3(  1, 11,  14), radius = 1.0 }
}

material = {
    terrain_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.85, 0.85, 0.65) }
            }
            scalars = {
                metallic             = 0.08
                roughness            = 0.60
                clearcoat            = 0.25
                clearcoat_roughness  = 0.45
            }
        }
    }

    key_light = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(3.2, 3.6, 5.0) } }
        }
    }

    fill_light = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(1.2, 1.1, 0.9) } }
        }
    }

    rim_light = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(1.8, 2.0, 2.8) } }
        }
    }
}

object = {
    terrain = { geometry = terrain,  material = terrain_mat }
    key     = { geometry = key_geo,  material = key_light   }
    fill    = { geometry = fill_geo, material = fill_light  }
    rim     = { geometry = rim_geo,  material = rim_light   }
}