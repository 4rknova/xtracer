title = Procedural Platonic Solids Test
description = Platonic solids generated in-scene via gen(). Each variant isolates one solid with a distinct material.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.90,0.94,1.00)
        b = col3(0.12,0.14,0.20)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 38
        position = vec3(0.0,5.5,-1.5)
        target   = vec3(0.0,1.25,2.7)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = 0
    }

    g_tetrahedron = {
        type   = mesh
        source = gen(tetrahedron)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,18,0)
            translation = vec3(-6.2,1.25,2.2)
        }
    }

    g_cube = {
        type   = mesh
        source = gen(cube)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,26,0)
            translation = vec3(-3.1,1.25,2.6)
        }
    }

    g_octahedron = {
        type   = mesh
        source = gen(octahedron)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,14,0)
            translation = vec3(0.0,1.25,2.7)
        }
    }

    g_dodecahedron = {
        type   = mesh
        source = gen(dodecahedron)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,-10,0)
            translation = vec3(3.1,1.25,2.6)
        }
    }

    g_icosahedron = {
        type   = mesh
        source = gen(icosahedron)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,-24,0)
            translation = vec3(6.2,1.25,2.2)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(0.0,7.8,-0.8)
        radius   = 1.1
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type        = graphpaper
                    base        = col3(0.62,0.64,0.68)
                    minor       = col3(0.50,0.52,0.56)
                    major       = col3(0.36,0.38,0.42)
                    scale       = 4
                    major_every = 4
                    minor_width = 0.025
                    major_width = 0.055
                }
            }
        }
    }

    m_tetra = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.88,0.38,0.32) }
                specular = { type = color, value = col3(0.22,0.22,0.22) }
            }
            scalars = { exponent = 78, reflectance = 0.08 }
        }
    }

    m_cube = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.90,0.70,0.32) }
                specular = { type = color, value = col3(0.22,0.22,0.22) }
            }
            scalars = { exponent = 78, reflectance = 0.08 }
        }
    }

    m_octa = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.34,0.74,0.44) }
                specular = { type = color, value = col3(0.22,0.22,0.22) }
            }
            scalars = { exponent = 78, reflectance = 0.08 }
        }
    }

    m_dodeca = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.30,0.58,0.90) }
                specular = { type = color, value = col3(0.22,0.22,0.22) }
            }
            scalars = { exponent = 78, reflectance = 0.08 }
        }
    }

    m_icosa = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.72,0.42,0.92) }
                specular = { type = color, value = col3(0.22,0.22,0.22) }
            }
            scalars = { exponent = 78, reflectance = 0.08 }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.2,4.0,3.5) }
            }
        }
    }

    mat_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.72,0.72,0.72) }
            }
        }
    }

    mat_ceramic = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.90,0.88,0.85) }
            }
            scalars = {
                metallic            = 0.0
                roughness           = 0.46
                ior                 = 1.55
                clearcoat           = 0.0
                clearcoat_roughness = 0.1
            }
        }
    }

    mat_gloss = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.12,0.28,0.82) }
            }
            scalars = {
                metallic            = 0.0
                roughness           = 0.06
                ior                 = 1.5
                clearcoat           = 0.9
                clearcoat_roughness = 0.04
            }
        }
    }

    mat_metal = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.95,0.76,0.22) }
            }
            scalars = {
                metallic            = 1.0
                roughness           = 0.10
                ior                 = 1.5
                clearcoat           = 0.0
                clearcoat_roughness = 0.08
            }
        }
    }

    mat_glass = {
        type = rough_dielectric
        properties = {
            samplers = {
                transmission = { type = color, value = col3(1.0,1.0,1.0) }
            }
            scalars = {
                roughness    = 0.04
                ior          = 1.5
                transparency = 0.98
            }
        }
    }
}

object = {
    floor         = { geometry = floor,         material = floor_matte  }
    g_tetrahedron = { geometry = g_tetrahedron, material = m_tetra      }
    g_cube        = { geometry = g_cube,        material = m_cube       }
    g_octahedron  = { geometry = g_octahedron,  material = m_octa      }
    g_dodecahedron = { geometry = g_dodecahedron, material = m_dodeca  }
    g_icosahedron = { geometry = g_icosahedron, material = m_icosa      }
    key_light     = { geometry = key_light,     material = emissive_key }
}

variants = {
    hide_base = true

    base = {
        name        = All Solids
        description = All five Platonic solids arranged side by side.
    }

    # ── Tetrahedron ──────────────────────────────────────────────────────────

    tetrahedron_matte = {
        name        = Tetrahedron · Matte
        description = Tetrahedron with flat Lambert diffuse in neutral gray.
        remove = {
            object = {
                g_cube         = {}
                g_octahedron   = {}
                g_dodecahedron = {}
                g_icosahedron  = {}
            }
        }
        set = {
            geometry = {
                g_tetrahedron = { modifiers = { translation = vec3(0,1.25,2.7) } }
            }
            object = {
                g_tetrahedron = { material = mat_matte }
            }
        }
    }

    tetrahedron_ceramic = {
        name        = Tetrahedron · Ceramic
        description = Tetrahedron as principled rough dielectric in warm white.
        remove = {
            object = {
                g_cube         = {}
                g_octahedron   = {}
                g_dodecahedron = {}
                g_icosahedron  = {}
            }
        }
        set = {
