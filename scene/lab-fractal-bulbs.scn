title = Fractal Bulbs Lab
description = Test scene for native xtcore mandelbulb and julia fractal surfaces.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.88,0.92,0.98)
        b = col3(0.09,0.10,0.14)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 42
        position = vec3(3,4,3)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(50,1,50)
            translation = vec3(0,-1,0)
        }
    }

    bulb_mandel = {
        type       = mandelbulb
        radius     = 1
        resolution = 20
        power      = 8.0
        bailout    = 4.0
    }

    bulb_julia = {
        type       = julia
	resolution = 32
	power      = 2.0
	bailout    = 8.0
	julia_c    = vec3(-0.12, 0.74, 0.28)
    }

    key_light = {
        type     = sphere
        position = vec3(3.2,5.4,-2.3)
        radius   = 0.85
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.54,0.57,0.61) }
            }
        }
    }

    bulb_surface = {
        type = lambert
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.69,0.77,0.90) }
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.0,3.7,3.2) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    bulb = { geometry = bulb_mandel, material = bulb_surface }
    key_light = { geometry = key_light, material = emissive_key }
}

variants = {
    hide_base = true

    mandelbulb = {
        name        = Mandelbulb
        description = Native analytic mandelbulb fractal geometry.
        set = {
            object = {
                bulb = { geometry = bulb_mandel, material = bulb_surface }
            }
        }
    }

    julia = {
        name        = Julia
        description = Native analytic julia fractal geometry.
        set = {
            object = {
                bulb = { geometry = bulb_julia, material = bulb_surface }
            }
        }
    }
}
