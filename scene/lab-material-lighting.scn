title = Material and Lighting Lab
description = Compact showcase of Lambert, Phong, Blinn-Phong, Dielectric and Emissive materials.
version     = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.92,0.95,1.0)
        b = col3(0.10,0.14,0.20)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 44
        position = vec3(0.0,2.6,-10.5)
        target   = vec3(0.0,0.7,2.3)
        up       = vec3(0,1,0)
    }

    close = {
        type     = thin-lens
        fov      = 35
        position = vec3(-1.2,1.8,-6.2)
        target   = vec3(-0.2,0.7,2.3)
        up       = vec3(0,1,0)
    }
}

geometry = {
    ground = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -1.0
    }

    matte_ball = {
        type     = sphere
        position = vec3(-4.0,0.0,2.4)
        radius   = 1.0
    }

    phong_ball = {
        type     = sphere
        position = vec3(-1.6,0.0,2.4)
        radius   = 1.0
    }

    blinn_ball = {
        type     = sphere
        position = vec3(0.8,0.0,2.4)
        radius   = 1.0
    }

    glass_ball = {
        type     = sphere
        position = vec3(3.3,0.0,2.4)
        radius   = 1.0
    }

    mesh_ico = {
        type   = mesh
        source = gen(icosahedron)
        modifiers = {
            scale       = vec3(1.2,1.2,1.2)
            rotation    = vec3(0,24,0)
            translation = vec3(-0.2,0.9,4.8)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(-1.8,4.5,-1.2)
        radius   = 0.65
    }

    rim_light = {
        type     = sphere
        position = vec3(4.2,2.8,0.5)
        radius   = 0.45
    }
}

material = {
    matte_floor = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.64,0.66,0.70)
                }
            }
        }
    }

    matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.86,0.52,0.34)
                }
            }
        }
    }

    phong = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.36,0.64,0.95)
                }
                specular = {
                    type  = color
                    value = col3(0.92,0.94,0.98)
                }
            }
            scalars = {
                exponent    = 84
                reflectance = 0.2
            }
        }
    }

    blinn = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.28,0.82,0.66)
                }
                specular = {
                    type  = color
                    value = col3(0.94,0.95,0.96)
                }
            }
            scalars = {
                exponent    = 128
                reflectance = 0.28
            }
        }
    }

    glass = {
        type = dielectric
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(1.0,1.0,1.0)
                }
            }
            scalars = {
                ior          = 1.5
                transparency = 0.96
                reflectance  = 0.04
            }
        }
    }

    light_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(8.5,7.0,5.6)
                }
            }
        }
    }

    light_rim = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(1.8,2.1,3.0)
                }
            }
        }
    }
}

object = {
    ground = {
        geometry = ground
        material = matte_floor
    }

    matte_ball = {
        geometry = matte_ball
        material = matte
    }

    phong_ball = {
        geometry = phong_ball
        material = phong
    }

    blinn_ball = {
        geometry = blinn_ball
        material = blinn
    }

    glass_ball = {
        geometry = glass_ball
        material = glass
    }

    mesh_ico = {
        geometry = mesh_ico
        material = blinn
    }

    key_light = {
        geometry = key_light
        material = light_key
    }

    rim_light = {
        geometry = rim_light
        material = light_rim
    }
}
