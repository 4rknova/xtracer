variants = {
    base = {
        name = Base
        description = Balanced hero framing with layered ridge depth, a warm cloth accent, and foreground foliage framing the overlook props.
    }

    golden_hour = {
        name = Golden Hour
        description = Warmer low sun and tighter framing to favor translucency, subsurface edges, and coat highlights.
        set = {
            default_camera = low
            environment = {
                type = rayleigh_sky
                config = {
                    sun_direction = vec3(-0.56,0.46,-0.58)
                    sun_intensity = col3(14,10,7)
                    beta_rayleigh = col3(0.20,0.27,0.58)
                    ground_color = col3(0.10,0.08,0.07)
                    density = 1.08
                    horizon_falloff = 1.45
                    sun_disk_radius = 1.2
                    sun_disk_intensity = 1.4
                    sun_glow_radius = 9.0
                    sun_glow_intensity = 0.28
                    sun_glow_falloff = 2.6
                }
            }
        }
    }

    alpine_clear = {
