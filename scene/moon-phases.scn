# ---------------------------------------------------------------------
# Physical scale
# ---------------------------------------------------------------------
#
# 1 scene unit = 1 mean lunar radius = 1,737.4 km
#
# Moon surface relief: ±10 km relative to the 1,737.4 km radius (~±0.57%).
# With displacement_scale = 0.008 and radius = 1.0, the maximum radial
# displacement applied by the renderer is 0.008 scene units (≈ 13.9 km).
#
# Displacement map source:  NASA/GSFC LRO LOLA DEM
# Color map source:         NASA/GSFC LRO WAC Global Mosaic (2025)
# Both maps are centered on 0° longitude.

# ---------------------------------------------------------------------
# Physical constants  (all in km)
# ---------------------------------------------------------------------

pi         = 3.14159265     # mathematical constant π
moon_r_km  = 1737.4         # mean lunar radius — defines the scene unit
sun_r_km   = 696000.0       # solar mean radius
au_km      = 149600000.0    # mean Earth–Sun distance  (1 AU)
solar_E    = 1361.0         # solar irradiance at 1 AU  (W/m²) — the solar constant
inv_sqrt2  = 0.70710678     # cos 45° = 1/√2  — used for the ±45° phase angles

# ---------------------------------------------------------------------
# Derived scene-unit values  (1 scene unit = moon_r_km)
# ---------------------------------------------------------------------
#
# moon_radius  =  1 (by definition)
# sun_radius   =  sun_r_km  / moon_r_km  =  696,000   / 1,737.4  ≈    400.6 units
# sun_d        =  au_km     / moon_r_km  =  149,600,000 / 1,737.4  ≈ 86,111 units
# sun_d_diag   =  sun_d · cos 45°  ≈  86,111 · 0.70711  ≈  60,877 units
#
# The Sun's angular diameter as seen from the Moon: ≈ 0.53°, matching the
# real value (and Earth's view — the reason total solar eclipses are possible).

moon_radius = 1.0
sun_radius  = $(<sun_r_km>  / <moon_r_km>)  # ≈  400.6 units
sun_d       = $(<au_km>     / <moon_r_km>)  # ≈  86,111 units
sun_d_diag  = $(<sun_d>     * <inv_sqrt2>)  # ≈  60,877 units

# ---------------------------------------------------------------------
# Sun emissive luminance
# ---------------------------------------------------------------------
#
# Irradiance from a uniform spherical emitter of radiance Le, radius r,
# distance d  (d ≫ r):
#
#   E = π · Le · (r / d)²
#
# Invert the irradiance formula  E = π · Le · (r/d)²  to solve for Le:
#
#   Le = E · (d/r)² / π
#      = solar_E · (au_km / sun_r_km)² / π
#      = 1361 · (149,600,000 / 696,000)² / π
#      = 1361 · 214.94² / π
#      ≈ 20,022,000  W/m²/sr
#
# This is the actual solar radiance value.
emission_multiplier = 0.001 # Reduce the emission intensity to allow for practical tone mapping
sun_Le = $(<emission_multiplier> * <solar_E> * <au_km> * <au_km> / (<sun_r_km> * <sun_r_km> * <pi>))

title       = Moon Phases
description = The Moon lit by a single spherical light source against a black void. Eight variants cover the classical phase cycle. Camera is fixed; only the light position changes per variant.
version     = 1.0
default_camera = cam

environment = {
    type   = color
    config = { value = col3(0.001, 0.001, 0.001) }
}

# ---------------------------------------------------------------------
# Camera — fixed, looking straight at the moon.
# ---------------------------------------------------------------------

camera = {
    camera = {
		type = thin-lens
		position = vec3(0, 0, 3)
		target = vec3(0, 0, 0)
		up = vec3(0, 1, 0)
		fov = 42
		flength = 0
		aperture = 0.0
	}
}

# ---------------------------------------------------------------------
# Geometry
#
# Moon is at the origin.  Camera is at +Z looking toward -Z.
# sun_geo is a single sphere; each variant overrides its position.
# Phase angle is measured from the camera direction (+Z):
#
#   0°   full          (0,        0, <sun_d>)       sun behind camera → full disc lit
#   45°  waxing gibb.  (<sun_d_diag>, 0, <sun_d_diag>)
#   90°  first quarter (<sun_d>,  0,  0)            right half lit
#   135° waxing cres.  (<sun_d_diag>, 0, -<sun_d_diag>)
#   180° new           (0,        0, -<sun_d>)      sun behind moon → dark disc
#   225° waning cres.  (-<sun_d_diag>, 0, -<sun_d_diag>)
#   270° last quarter  (-<sun_d>, 0,  0)            left half lit
#   315° waning gibb.  (-<sun_d_diag>, 0, <sun_d_diag>)
# ---------------------------------------------------------------------

geometry = {
    moon_geo = {
        type               = mesh
        source             = gen(displaced_sphere)
        resolution         = 8
        radius             = <moon_radius>
        displacement_scale  = 0.008
        displacement_smooth = 0
        height_sampler = {
            type       = texture
            # source     = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/ldem_3_8bit.jpg
            source     = textures/ldem_16_uint.png
            filtering  = bilinear
            multiplier = 1.0
        }
    }

    # Default: full moon position. Variants override position only.
    sun_geo = {
        type     = sphere
        position = vec3(0, 0, <sun_d>)
        radius   = <sun_radius>
    }
}

# ---------------------------------------------------------------------
# Materials
# ---------------------------------------------------------------------

material = {
    moon_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type      = texture
                    # source    = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color_2k.jpg
                    source    = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color.exr
                    filtering = bilinear
                }
            }
            scalars = {
                roughness = 0.92
                metallic  = 0.0
            }
        }
    }

    sun_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(<sun_Le>, <sun_Le>, <sun_Le>)
                }
            }
        }
    }
}

# ---------------------------------------------------------------------
# Objects
# ---------------------------------------------------------------------

object = {
    moon = { geometry = moon_geo, material = moon_mat }
    sun  = { geometry = sun_geo,  material = sun_mat  }
}

# ---------------------------------------------------------------------
# Variants — only the sun position changes
# ---------------------------------------------------------------------

variants = {

    full = {
        name        = Full Moon
        description = Sun at 0° (behind camera). Entire visible hemisphere lit.
    }

    waxing_gibbous = {
        name        = Waxing Gibbous
        description = Sun at 45° (front-right). Most of the disc lit, terminator on the left third.
        set = {
            geometry = {
                sun_geo = { position = vec3(<sun_d_diag>, 0, <sun_d_diag>) }
            }
        }
    }

    first_quarter = {
        name        = First Quarter
        description = Sun at 90° (right). Clean vertical terminator — right half lit, left half dark.
        set = {
            geometry = {
                sun_geo = { position = vec3(<sun_d>, 0, 0) }
            }
        }
    }

    waxing_crescent = {
        name        = Waxing Crescent
        description = Sun at 135° (back-right). Thin crescent on the right limb.
        set = {
            geometry = {
                sun_geo = { position = vec3(<sun_d_diag>, 0, -<sun_d_diag>) }
            }
        }
    }

    new = {
        name        = New Moon
        description = Sun at 180° (behind moon). Dark disc — lit hemisphere faces away from camera.
        set = {
            geometry = {
                sun_geo = { position = vec3(0, 0, -<sun_d>) }
            }
        }
    }

    waning_crescent = {
        name        = Waning Crescent
        description = Sun at 225° (back-left). Thin crescent on the left limb.
        set = {
            geometry = {
                sun_geo = { position = vec3(-<sun_d_diag>, 0, -<sun_d_diag>) }
            }
        }
    }

    last_quarter = {
        name        = Last Quarter
        description = Sun at 270° (left). Mirror of first quarter — left half lit, right half dark.
        set = {
            geometry = {
                sun_geo = { position = vec3(-<sun_d>, 0, 0) }
            }
        }
    }

    waning_gibbous = {
        name        = Waning Gibbous
        description = Sun at 315° (front-left). Most of the disc lit, terminator on the right third.
        set = {
            geometry = {
                sun_geo = { position = vec3(-<sun_d_diag>, 0, <sun_d_diag>) }
            }
        }
    }
}
