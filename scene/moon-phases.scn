# The moon has surface relief of about ±10 km relative to its 1737 km radius
# That is roughly ±0.57% of the radius.
# Given the current displacement_scale of 0.1 and radius of 1.0, the maximum
# displacement is already 0.1 units.

# The displacement map, at 64, 16, and 4 pixels per degree, centered on 0° longitude. Available as either floating-point TIFFs in kilometers, relative to a radius of 1737.4 km, or unsigned 16-bit TIFFs in half-meters, relative to a radius of 1727400 meters.
# The 2025 color map, available as a full-size float16 EXR file and as 16-bit TIFFs of various sizes. The EXR file is encoded in linear color with slightly more dynamic range, while the sRGB-encoded TIFFs are more broadly supported. The map is centered on 0° longitude.

title       = Moon Phases
description = The Moon lit by a single spherical light source against a black void. Eight variants cover the classical phase cycle. Camera is fixed; only the light position changes per variant.
version     = 1.0
default_camera = cam

environment = {
    type   = color
    config = { value = col3(0.0, 0.0, 0.0) }
}

# ---------------------------------------------------------------------
# Camera — fixed, looking straight at the moon.
# ---------------------------------------------------------------------

camera = {
    cam = {
        type     = thin-lens
        position = vec3(0, 0, 3)
        target   = vec3(0, 0, 0)
        up       = vec3(0, 1, 0)
        fov      = 42
    }
}

# ---------------------------------------------------------------------
# Geometry
#
# Moon is at the origin.  Camera is at +Z looking toward -Z.
# sun_geo is a single sphere; each variant overrides its position.
# Phase angle is measured from the camera direction (+Z):
#
#   0°   full          (0,  0,  50)  sun behind camera → full disc lit
#   45°  waxing gibb.  (35, 0,  35)
#   90°  first quarter (50, 0,   0)  right half lit
#   135° waxing cres.  (35, 0, -35)
#   180° new           (0,  0, -50)  sun behind moon → dark disc
#   225° waning cres. (-35, 0, -35)
#   270° last quarter (-50, 0,   0)  left half lit
#   315° waning gibb. (-35, 0,  35)
# ---------------------------------------------------------------------

geometry = {
    moon_geo = {
        type               = mesh
        source             = gen(displaced_sphere)
        resolution         = 7
        radius             = 1.0
        displacement_scale = 0.025
        height_sampler = {
            type       = texture
            # source     = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/ldem_3_8bit.jpg
            source     = textures/ldem_16_uint.png
            filtering  = bilinear
            multiplier = 1.0
        }
    }

    # Default: full moon position. Variants override position only.
    sun_geo = {
        type     = sphere
        position = vec3(0, 0, 50)
        radius   = 5.0
    }
}

# ---------------------------------------------------------------------
# Materials
# ---------------------------------------------------------------------

material = {
    moon_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type      = texture
                    # source    = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color_2k.jpg
                    source    = https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color.exr
                    filtering = bilinear
                }
            }
            scalars = {
                roughness = 0.92
                metallic  = 0.0
            }
        }
    }

    # Sun at distance 50, radius 5 → solid angle Ω ≈ π*(5/50)² ≈ 0.031 sr.
    # Emissive ~40 → irradiance ~1.3 at the lit hemisphere.
    sun_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(40, 40, 40)
                }
            }
        }
    }
}

# ---------------------------------------------------------------------
# Objects
# ---------------------------------------------------------------------

object = {
    moon = { geometry = moon_geo, material = moon_mat }
    sun  = { geometry = sun_geo,  material = sun_mat  }
}

# ---------------------------------------------------------------------
# Variants — only the sun position changes
# ---------------------------------------------------------------------

variants = {

    full = {
        name        = Full Moon
        description = Sun at 0° (behind camera). Entire visible hemisphere lit.
    }

    waxing_gibbous = {
        name        = Waxing Gibbous
        description = Sun at 45° (front-right). Most of the disc lit, terminator on the left third.
        set = {
            geometry = {
                sun_geo = { position = vec3(35, 0, 35) }
            }
        }
    }

    first_quarter = {
        name        = First Quarter
        description = Sun at 90° (right). Clean vertical terminator — right half lit, left half dark.
        set = {
            geometry = {
                sun_geo = { position = vec3(50, 0, 0) }
            }
        }
    }

    waxing_crescent = {
        name        = Waxing Crescent
        description = Sun at 135° (back-right). Thin crescent on the right limb.
        set = {
            geometry = {
                sun_geo = { position = vec3(35, 0, -35) }
            }
        }
    }

    new = {
        name        = New Moon
        description = Sun at 180° (behind moon). Dark disc — lit hemisphere faces away from camera.
        set = {
            geometry = {
                sun_geo = { position = vec3(0, 0, -50) }
            }
        }
    }

    waning_crescent = {
        name        = Waning Crescent
        description = Sun at 225° (back-left). Thin crescent on the left limb.
        set = {
            geometry = {
                sun_geo = { position = vec3(-35, 0, -35) }
            }
        }
    }

    last_quarter = {
        name        = Last Quarter
        description = Sun at 270° (left). Mirror of first quarter — left half lit, right half dark.
        set = {
            geometry = {
                sun_geo = { position = vec3(-50, 0, 0) }
            }
        }
    }

    waning_gibbous = {
        name        = Waning Gibbous
        description = Sun at 315° (front-left). Most of the disc lit, terminator on the right third.
        set = {
            geometry = {
                sun_geo = { position = vec3(-35, 0, 35) }
            }
        }
    }
}
