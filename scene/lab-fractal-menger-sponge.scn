title = Procedural Menger Sponge Showcase
description = Demonstrates gen(menger_sponge) with adjustable subdivision depth via resolution.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.90,0.93,0.98)
        b = col3(0.10,0.11,0.15)
    }
}

sponge_resolution = 3

camera = {
    default = {
        type     = thin-lens
        fov      = 45
        position = vec3(0,7.5,-10)
        target   = vec3(0.0,0,0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(50,1,50)
            translation = vec3(0,-1.5,0)
        }
    }

    menger_main_gen = {
        type       = mesh
        source     = gen(menger_sponge)
        resolution = <sponge_resolution>
        modifiers = {
	    scale       = vec3(2.0,2.0,2.0)
	    rotation    = vec3(0,0.7853982,0)
        }
    }

    menger_main_gen_implicit = {
        type       = mesh
        source     = gen(menger_sponge_implicit)
        resolution = <sponge_resolution>
        modifiers = {
	    scale       = vec3(2.0,2.0,2.0)
	    rotation    = vec3(0,0.7853982,0)
        }
    }

    menger_main_analytic = {
        type       = menger_sponge
        orientation = vec3(0,0.7853982,0)
        radius     = 1.0
        resolution = <sponge_resolution>
    }

    key_light = {
        type     = sphere
        position = vec3(4.2,6.3,-3.0)
        radius   = 0.85
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.56,0.58,0.62) }
            }
        }
    }

    menger_surface = {
        type = lambert
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.67,0.76,0.88) }
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.0,3.6,3.1) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    key_light = { geometry = key_light, material = emissive_key }
}

variants = {
    hide_base = true

    gen_mesh = {
        name        = Menger - Gen Mesh
        description = Uses mesh generator source = gen(menger_sponge).
        set = {
            object = {
                menger_main = { geometry = menger_main_gen, material = menger_surface }
            }
        }
    }

    gen_implicit = {
        name        = Menger - Gen Implicit Mesh
        description = Uses mesh generator source = gen(menger_sponge_implicit).
        set = {
            object = {
                menger_main = { geometry = menger_main_gen_implicit, material = menger_surface }
            }
        }
    }

    analytic = {
        name        = Menger - Analytic Surface
        description = Uses native analytic geometry.type = menger_sponge.
        set = {
            object = {
                menger_main = { geometry = menger_main_analytic, material = menger_surface }
            }
        }
    }
}
