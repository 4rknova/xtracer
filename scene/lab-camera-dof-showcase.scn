title = Camera Depth of Field Showcase
description = Thin-lens depth-of-field demo with dense foreground, focus-plane, and background sphere stacks.
version = 1.0
default_camera = default

environment = {
    type = gradient
    config = {
        a = col3(0.92,0.96,1.00)
        b = col3(0.14,0.16,0.22)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 38
        position = vec3(0,2.0,-11.0)
        target   = vec3(0,1.2,2.2)
        up       = vec3(0,1,0)
        flength  = 12.5
        aperture = 0.5
    }

    no_dof = {
        type     = thin-lens
        fov      = 38
        position = vec3(0,2.0,-11.0)
        target   = vec3(0,1.2,2.2)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(24,1,24)
            translation = vec3(0,0,0)
        }
    }

    near_subject_big = {
        type     = sphere
        position = vec3(-5.4,1.95,-0.9)
        radius   = 1.75
    }

    near_subject_small = {
        type     = sphere
        position = vec3(-3.5,0.62,-2.6)
        radius   = 0.60
    }

    near_subject_medium = {
        type     = sphere
        position = vec3(4.3,1.12,-1.6)
        radius   = 1.08
    }

    near_subject_tiny = {
        type     = sphere
        position = vec3(2.8,0.52,-3.1)
        radius   = 0.42
    }

    focus_subject_center = {
        type     = sphere
        position = vec3(0.0,1.2,2.2)
        radius   = 1.18
    }

    focus_band_left = {
        type     = sphere
        position = vec3(-5.0,0.86,2.1)
        radius   = 0.80
    }

    focus_band_right = {
        type     = sphere
        position = vec3(5.2,0.84,2.45)
        radius   = 0.88
    }

    focus_band_back = {
        type     = sphere
        position = vec3(-4.3,0.76,4.8)
        radius   = 0.72
    }

    far_subject_big = {
        type     = sphere
        position = vec3(5.8,1.75,8.4)
        radius   = 1.92
    }

    far_subject_small = {
        type     = sphere
        position = vec3(2.6,0.70,10.0)
        radius   = 0.72
    }

    far_subject_medium = {
        type     = sphere
        position = vec3(-5.2,1.20,11.2)
        radius   = 1.18
    }

    far_subject_huge = {
        type     = sphere
        position = vec3(0.0,2.5,14.8)
        radius   = 2.90
    }

    far_subject_tiny = {
        type     = sphere
        position = vec3(-2.6,0.44,8.6)
        radius   = 0.36
    }

    key_light = {
        type     = sphere
        position = vec3(1.8,7.0,-1.4)
        radius   = 0.9
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.56,0.58,0.62) }
            }
        }
    }

    near_mat = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.92,0.42,0.30) }
                specular = { type = color, value = col3(0.28,0.22,0.22) }
            }
            scalars = {
                exponent    = 84
                reflectance = 0.10
            }
        }
    }

    focus_mat = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.34,0.76,0.50) }
                specular = { type = color, value = col3(0.24,0.28,0.24) }
            }
            scalars = {
                exponent    = 96
                reflectance = 0.12
            }
        }
    }

    far_mat = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.36,0.56,0.94) }
                specular = { type = color, value = col3(0.22,0.24,0.30) }
            }
            scalars = {
                exponent    = 96
                reflectance = 0.12
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(5.2,5.0,4.6) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    near_subject_big = { geometry = near_subject_big, material = near_mat }
    near_subject_small = { geometry = near_subject_small, material = near_mat }
    near_subject_medium = { geometry = near_subject_medium, material = near_mat }
    near_subject_tiny = { geometry = near_subject_tiny, material = near_mat }
    focus_subject_center = { geometry = focus_subject_center, material = focus_mat }
    focus_band_left = { geometry = focus_band_left, material = focus_mat }
    focus_band_right = { geometry = focus_band_right, material = focus_mat }
    focus_band_back = { geometry = focus_band_back, material = focus_mat }
    far_subject_big = { geometry = far_subject_big, material = far_mat }
    far_subject_small = { geometry = far_subject_small, material = far_mat }
    far_subject_medium = { geometry = far_subject_medium, material = far_mat }
    far_subject_huge = { geometry = far_subject_huge, material = far_mat }
    far_subject_tiny = { geometry = far_subject_tiny, material = far_mat }
    key_light = { geometry = key_light, material = emissive_key }
}
