material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.46,0.50,0.56) }
            }
        }
    }

    near_ceramic = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type    = checker
                    a       = col3(0.90,0.38,0.26)
                    b       = col3(0.60,0.22,0.16)
                    scale_u = 7
                    scale_v = 7
                }
            }
        }
    }

    fg_right_metal = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type        = graphpaper
