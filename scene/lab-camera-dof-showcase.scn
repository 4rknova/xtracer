object = {
    floor = { geometry = floor, material = floor_matte }

    fg_left = { geometry = fg_left, material = near_ceramic }
    fg_right = { geometry = fg_right, material = fg_right_metal }
    fg_center = { geometry = fg_center, material = fg_center_metal }
    spec_probe_near = { geometry = spec_probe_near, material = spec_probe_near_mat }

    focus_center = { geometry = focus_center, material = focus_glass }
    focus_left = { geometry = focus_left, material = focus_left_gloss }
    focus_right = { geometry = focus_right, material = focus_right_gloss }
    spec_probe_focus = { geometry = spec_probe_focus, material = spec_probe_focus_mat }

    bg_left = { geometry = bg_left, material = bg_left_matte }
    bg_right = { geometry = bg_right, material = bg_right_satin }
    bg_center = { geometry = bg_center, material = bg_center_matte }
