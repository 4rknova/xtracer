    }

    near_light_l = {
        type     = sphere
        position = vec3(-6.0,0.92,2.4)
        radius   = 0.22
    }

    near_light_r = {
        type     = sphere
        position = vec3(6.1,0.92,2.8)
        radius   = 0.22
    }

    near_light_c = {
