title = Camera Depth of Field Showcase
description = DOF bokeh lab with mixed procedural forms, distinct material samplers, and aperture-shape comparison cameras.
version = 2.0
default_camera = default

environment = {
    type = gradient
    config = {
        a = col3(0.82,0.88,0.96)
        b = col3(0.05,0.06,0.10)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 6
        aperture_rotation = 12
    }

    round_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 0
        aperture_rotation = 0
    }

    square_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 4
        aperture_rotation = 45
    }

    triangle_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 3
        aperture_rotation = 30
    }

    pentagon_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 5
        aperture_rotation = 18
    }

    heptagon_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 7
        aperture_rotation = 10
    }

    octagon_bokeh = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 13.5
        aperture = 0.65
        aperture_blades = 8
        aperture_rotation = 22.5
    }

    no_dof = {
        type     = thin-lens
        fov      = 33
        position = vec3(0,1.65,-8.0)
        target   = vec3(0,1.15,5.5)
        up       = vec3(0,1,0)
        flength  = 0
        aperture = 0
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
