title = Room Three Spheres Specular
description = Three spheres in a room (specular, sphere lights).
version     = 0.5

camera = {

	default = {
        type = thin-lens

		fov = 45

		position = {
			z = -20
		}

		up = {
			y = 1
		}
	}

	back = {
        type = thin-lens

		fov = 45

		position = {
			y = 1
			z = 4.8
		}

		target = {
			z = 3
		}

		up = {
			y = 1
		}
	}

	side = {
        type = thin-lens

		fov = 45

		position = {
			x = 3
			y = 3
			z = -14
		}

		up = {
			y = 1
		}
	}
}

geometry = {

	red_ball = {
		type = sphere
		position = {
			x = 0.8
			y = -3.05
			z = -1
		}
		radius = 0.95
	}
	green_ball = {
		type = sphere
		position = {
			x = 3.5
			y = -3.3
			z = 3.5
		}
		radius = 0.77
	}
	blue_ball = {
		type = sphere
		position = {
			x = -2.2
			y = -2.45
			z = 0.8
		}
		radius = 1.55
	}
	floor = {
		type = plane
		normal = {
			y = 1
		}
		distance = -4
	}
	ceiling = {
		type = plane
		normal = {
			y = -1
		}
		distance = 4
	}
	back = {
		type = plane
		normal = {
			z = -1
		}
		distance = 5
	}
	left_wall = {
		type = plane
		normal = {
			x = 1
		}
		distance = -5
	}
	right_wall = {
		type = plane
		normal = {
			x = -1
		}
		distance = 5
	}

	l0 = {
		type = sphere

        radius = 0.25

		position = {
			x = 0
			y = 1.5
			z = -4
		}

		intensity = {
			r = 1
			g = 1
			b = 1
		}
	}
}

object = {
	red_ball = {
		geometry = red_ball
		material = phong_red
	}
	green_ball = {
		geometry = green_ball
		material = phong_green
	}
	blue_ball = {
		geometry = blue_ball
		material = phong_blue
	}
	floor = {
		geometry = floor
		material = phong_grey
	}
	ceiling = {
		geometry = ceiling
		material = phong_grey
	}
	back = {
		geometry = back
		material = phong_grey
	}
	right_wall = {
		geometry = right_wall
		material = phong_blue
	}
	left_wall = {
		geometry = left_wall
		material = phong_green
	}
    light0 = {
        geometry = l0
        material = light
    }
}

material = {
	phong_red = {
