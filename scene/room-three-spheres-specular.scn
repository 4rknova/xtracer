                    value = col3(0.5,0,0)
                }
                specular = {
                    type  = color
                    value = col3(0.5,0,0)
                }
            }

            scalars = {
                reflectance = 0.5
                exponent    = 128
            }
        }
	}

	phong_green = {
		type = phong

        properties = {
            samplers = {
