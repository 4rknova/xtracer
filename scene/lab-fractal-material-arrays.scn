title       = Fractal Material Arrays Demo
description = Orbit-trap driven material arrays. 5 fractal types x 3 orbit-trap channels. Each variant shows a single fractal with a 3-material array sliced by material_selector.
version     = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.78,0.82,0.92)
        b = col3(0.06,0.07,0.12)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 45
        position = vec3(0.3,3.5,3.5)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
        flength         = 4
        aperture        = 0.025
        aperture_blades = 6
    }
}

geometry = {

    # ── Mandelbulb  power=8 classic ──────────────────────────────────

    bulb_sphere = {
        type       = mandelbulb
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        power      = 8.0
        bailout    = 4.0
        orbit_trap = sphere
    }

    bulb_smooth = {
        type       = mandelbulb
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        power      = 8.0
        bailout    = 4.0
        orbit_trap = smooth_iter
    }

    bulb_planey = {
        type       = mandelbulb
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        power      = 8.0
        bailout    = 4.0
        orbit_trap = plane_y
    }

    # ── Julia  classic seed, power=2 ─────────────────────────────────

    julia_sphere = {
        type       = julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 32
        power      = 2.0
        bailout    = 8.0
        julia_c    = vec3(-0.12, 0.74, 0.28)
        orbit_trap = sphere
    }

    julia_smooth = {
        type       = julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 32
        power      = 2.0
        bailout    = 8.0
        julia_c    = vec3(-0.12, 0.74, 0.28)
        orbit_trap = smooth_iter
    }

    julia_planey = {
        type       = julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 32
        power      = 2.0
        bailout    = 8.0
        julia_c    = vec3(-0.12, 0.74, 0.28)
        orbit_trap = plane_y
    }

    # ── MandelBox  scale=-2.5 classic ────────────────────────────────

    box_sphere = {
        type       = mandelbox
        position   = vec3(0,0,0)
        radius     = 0.6
        resolution = 12
        fold_size  = 1.0
        min_r      = 0.5
        scale      = -2.5
        bailout    = 100.0
        orbit_trap = sphere
    }

    box_smooth = {
        type       = mandelbox
        position   = vec3(0,0,0)
        radius     = 0.6
        resolution = 12
        fold_size  = 1.0
        min_r      = 0.5
        scale      = -2.5
        bailout    = 100.0
        orbit_trap = smooth_iter
    }

    box_planey = {
        type       = mandelbox
        position   = vec3(0,0,0)
        radius     = 0.6
        resolution = 12
        fold_size  = 1.0
        min_r      = 0.5
        scale      = -2.5
        bailout    = 100.0
        orbit_trap = plane_y
    }

    # ── QuaternionJulia  smooth bulb ─────────────────────────────────

    quat_sphere = {
        type       = quaternion_julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        quat_c     = vec3(0.4, 0.6, 0.3)
        quat_cw    = 0.35
        bailout    = 4.0
        orbit_trap = sphere
    }

    quat_smooth = {
        type       = quaternion_julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        quat_c     = vec3(0.4, 0.6, 0.3)
        quat_cw    = 0.35
        bailout    = 4.0
        orbit_trap = smooth_iter
    }

    quat_planey = {
        type       = quaternion_julia
        position   = vec3(0,0,0)
        radius     = 1.1
        resolution = 12
        quat_c     = vec3(0.4, 0.6, 0.3)
        quat_cw    = 0.35
        bailout    = 4.0
        orbit_trap = plane_y
    }

    # ── BurningShip3D  power=2 ───────────────────────────────────────

    ship_sphere = {
        type       = burning_ship_3d
        position   = vec3(0,0,0)
        radius     = 1.2
        resolution = 12
        power      = 2.0
        bailout    = 4.0
        orbit_trap = sphere
    }

    ship_smooth = {
        type       = burning_ship_3d
        position   = vec3(0,0,0)
        radius     = 1.2
        resolution = 12
        power      = 2.0
        bailout    = 4.0
        orbit_trap = smooth_iter
    }

    ship_planey = {
        type       = burning_ship_3d
        position   = vec3(0,0,0)
        radius     = 1.2
        resolution = 12
        power      = 2.0
        bailout    = 4.0
        orbit_trap = plane_y
    }

    # ── Floor and lights ─────────────────────────────────────────────

    floor_geo = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers  = {
            scale       = vec3(40,1,40)
            translation = vec3(0,-1.5,0)
        }
    }

    key_geo = {
        type     = sphere
        position = vec3(4,8,-4)
        radius   = 1.2
    }

    fill_geo = {
        type     = sphere
        position = vec3(-6,3,5)
        radius   = 2.0
    }

    rim_geo = {
        type     = sphere
        position = vec3(1,5,-8)
        radius   = 1.5
    }
}

material = {

    # ── Mandelbulb palette: Sapphire depths ──────────────────────────
    # m0 = deep interior (orbit near origin), m2 = outer surface

    bulb_m0 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.02,0.04,0.20) } }
            scalars  = { metallic = 0.85, roughness = 0.06 }
        }
    }

    bulb_m1 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.14,0.36,0.72) } }
            scalars  = { metallic = 0.45, roughness = 0.20 }
        }
    }

    bulb_m2 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.58,0.80,0.98) } }
            scalars  = { metallic = 0.0, roughness = 0.07, clearcoat = 1.0, clearcoat_roughness = 0.04 }
        }
    }

    # ── Julia palette: Ember glow ────────────────────────────────────

    julia_m0 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.24,0.02,0.04) } }
            scalars  = { metallic = 0.0, roughness = 0.35 }
        }
    }

    julia_m1 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.88,0.28,0.10) } }
            scalars  = { metallic = 0.15, roughness = 0.22 }
        }
    }

    julia_m2 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.98,0.90,0.62) } }
            scalars  = { metallic = 0.0, roughness = 0.06, clearcoat = 0.7, clearcoat_roughness = 0.05 }
        }
    }

    # ── MandelBox palette: Verdant mineral ───────────────────────────

    box_m0 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.04,0.16,0.06) } }
            scalars  = { metallic = 0.1, roughness = 0.55 }
        }
    }

    box_m1 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.10,0.55,0.22) } }
            scalars  = { metallic = 0.35, roughness = 0.20 }
        }
    }

    box_m2 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.92,0.84,0.42) } }
            scalars  = { metallic = 0.60, roughness = 0.10 }
        }
    }

    # ── QuaternionJulia palette: Amethyst geode ──────────────────────

    quat_m0 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.10,0.02,0.22) } }
            scalars  = { metallic = 0.25, roughness = 0.05 }
        }
    }

    quat_m1 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.52,0.12,0.88) } }
            scalars  = { metallic = 0.40, roughness = 0.14 }
        }
    }

    quat_m2 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.92,0.74,0.98) } }
            scalars  = { metallic = 0.0, roughness = 0.06, clearcoat = 1.0, clearcoat_roughness = 0.03 }
        }
    }

    # ── BurningShip palette: Forge and cinder ────────────────────────

    ship_m0 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.3,0.4,0.6) } }
            scalars  = { metallic = 0.1, roughness = 0.65 }
        }
    }

    ship_m1 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.82,0.32,0.04) } }
            scalars  = { metallic = 0.0, roughness = 0.28 }
        }
    }

    ship_m2 = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(1.0,0.94,0.52) } }
            scalars  = { metallic = 0.0, roughness = 0.05, clearcoat = 0.6, clearcoat_roughness = 0.06 }
        }
    }

    # ── Floor and lights ─────────────────────────────────────────────

    floor_mat = {
        type = principled
        properties = {
            samplers = { base_color = { type = color, value = col3(0.32,0.32,0.34) } }
            scalars  = { metallic = 0.0, roughness = 0.72 }
        }
    }

    light_key = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(7.5,6.8,5.6) } }
        }
    }

    light_fill = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(1.4,1.8,3.8) } }
        }
    }

    light_rim = {
        type = emissive
        properties = {
            samplers = { emissive = { type = color, value = col3(5.0,4.8,6.5) } }
        }
    }
}

object = {
    fractal = {
        geometry  = bulb_sphere
        materials = { a = bulb_m0, b = bulb_m1, c = bulb_m2 }
    }
    floor      = { geometry = floor_geo,  material = floor_mat  }
    key_light  = { geometry = key_geo,    material = light_key  }
    fill_light = { geometry = fill_geo,   material = light_fill }
    rim_light  = { geometry = rim_geo,    material = light_rim  }
}

variants = {
    hide_base = true

    # ── Mandelbulb ───────────────────────────────────────────────────

    bulb_sphere = {
        name        = Mandelbulb — Sphere trap
        description = Sphere orbit trap: min|z| across all orbit steps drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = bulb_sphere
                    materials = { a = bulb_m0, b = bulb_m1, c = bulb_m2 }
                }
            }
        }
    }

    bulb_smooth = {
        name        = Mandelbulb — Smooth iter trap
        description = Smooth iteration count (continuous escape speed) drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = bulb_smooth
                    materials = { a = bulb_m0, b = bulb_m1, c = bulb_m2 }
                }
            }
        }
    }

    bulb_planey = {
        name        = Mandelbulb — Plane Y trap
        description = Plane orbit trap: min|z.y| across all orbit steps drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = bulb_planey
                    materials = { a = bulb_m0, b = bulb_m1, c = bulb_m2 }
                }
            }
        }
    }

    # ── Julia ────────────────────────────────────────────────────────

    julia_sphere = {
        name        = Julia — Sphere trap
        description = Julia fractal, seed (-0.72, 0.24, 0.28). Sphere trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = julia_sphere
                    materials = { a = julia_m0, b = julia_m1, c = julia_m2 }
                }
            }
        }
    }

    julia_smooth = {
        name        = Julia — Smooth iter trap
        description = Julia fractal. Smooth iteration count drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = julia_smooth
                    materials = { a = julia_m0, b = julia_m1, c = julia_m2 }
                }
            }
        }
    }

    julia_planey = {
        name        = Julia — Plane Y trap
        description = Julia fractal. Plane Y orbit trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = julia_planey
                    materials = { a = julia_m0, b = julia_m1, c = julia_m2 }
                }
            }
        }
    }

    # ── MandelBox ────────────────────────────────────────────────────

    box_sphere = {
        name        = MandelBox — Sphere trap
        description = MandelBox scale=-2.5. Sphere trap (min|z|) drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = box_sphere
                    materials = { a = box_m0, b = box_m1, c = box_m2 }
                }
            }
        }
    }

    box_smooth = {
        name        = MandelBox — Smooth iter trap
        description = MandelBox scale=-2.5. Escape iteration count drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = box_smooth
                    materials = { a = box_m0, b = box_m1, c = box_m2 }
                }
            }
        }
    }

    box_planey = {
        name        = MandelBox — Box trap
        description = MandelBox scale=-2.5. Box orbit trap (min Chebyshev distance) drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = box_planey
                    materials = { a = box_m0, b = box_m1, c = box_m2 }
                }
            }
        }
    }

    # ── QuaternionJulia ──────────────────────────────────────────────

    quat_sphere = {
        name        = QuaternionJulia — Sphere trap
        description = Quaternion Julia set. Sphere trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = quat_sphere
                    materials = { a = quat_m0, b = quat_m1, c = quat_m2 }
                }
            }
        }
    }

    quat_smooth = {
        name        = QuaternionJulia — Smooth iter trap
        description = Quaternion Julia set. Smooth iteration count drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = quat_smooth
                    materials = { a = quat_m0, b = quat_m1, c = quat_m2 }
                }
            }
        }
    }

    quat_planey = {
        name        = QuaternionJulia — Plane Y trap
        description = Quaternion Julia set. Plane Y orbit trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = quat_planey
                    materials = { a = quat_m0, b = quat_m1, c = quat_m2 }
                }
            }
        }
    }

    # ── BurningShip3D ────────────────────────────────────────────────

    ship_sphere = {
        name        = BurningShip3D — Sphere trap
        description = Burning Ship 3D, power=2. Sphere trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = ship_sphere
                    materials = { a = ship_m0, b = ship_m1, c = ship_m2 }
                }
            }
        }
    }

    ship_smooth = {
        name        = BurningShip3D — Smooth iter trap
        description = Burning Ship 3D, power=2. Smooth iteration count drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = ship_smooth
                    materials = { a = ship_m0, b = ship_m1, c = ship_m2 }
                }
            }
        }
    }

    ship_planey = {
        name        = BurningShip3D — Plane Y trap
        description = Burning Ship 3D, power=2. Plane Y orbit trap drives material bands.
        set = {
            object = {
                fractal = {
                    geometry  = ship_planey
