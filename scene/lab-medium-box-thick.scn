title = Box Fog Density Variants
description = Box-bounded fog study with stronger volumetric lighting and clearer low/medium/high density reads.
version = 1.0
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction = vec3(-0.38,0.74,-0.30)
        sun_intensity = col3(18.0,16.0,13.0)
        beta_rayleigh = col3(0.16,0.31,0.74)
        ground_color = col3(0.030,0.032,0.040)
        density = 1.15
        horizon_falloff = 1.8
        sun_disk_radius = 0.95
        sun_disk_intensity = 1.1
        sun_glow_radius = 8.0
        sun_glow_intensity = 0.22
        sun_glow_falloff = 3.0
    }
}

camera = {
    hero = {
        type     = thin-lens
        fov      = 45
        position = vec3(0.0,2.2,-8.0)
        target   = vec3(0.0,1.2,0.0)
        up       = vec3(0,1,0)
    }
	interactive_hero = {
		type = thin-lens
		position = vec3(-0.104437, 2.540782, -4.315834)
		target = vec3(-0.104437, 1.258736, 0.346152)
		up = vec3(0, 0.964205, 0.265156)
		fov = 45
		flength = 1.0
		aperture = 0.0
	}
}

geometry = {
    medium_box = {
        type       = mesh
        source     = gen(cube)
        resolution = 1
        modifiers = {
            scale       = vec3(3.0,1.0,3.0)
            translation = vec3(0.0,1.1,0.0)
        }
    }

    wall_left = {
        type       = mesh
        source     = gen(cube)
        resolution = 1
        modifiers = {
            scale       = vec3(0.14,1.0,3.0)
            translation = vec3(-1.56,1.1,0.0)
        }
    }

    wall_right = {
        type       = mesh
        source     = gen(cube)
        resolution = 1
        modifiers = {
            scale       = vec3(0.14,1.0,3.0)
            translation = vec3(1.56,1.1,0.0)
        }
    }

    wall_far = {
        type       = mesh
        source     = gen(cube)
        resolution = 1
        modifiers = {
            scale       = vec3(3.0,1.0,0.14)
            translation = vec3(0.0,1.1,1.56)
        }
    }

    wall_bottom = {
        type       = mesh
        source     = gen(cube)
        resolution = 1
        modifiers = {
            scale       = vec3(3.0,0.14,3.0)
            translation = vec3(0.0,0.53,0.0)
        }
    }

    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(16.0,1.0,16.0)
            translation = vec3(0.0,0.0,0.0)
        }
    }

    top_light = {
        type     = sphere
        position = vec3(0.0,4.2,0.0)
        radius   = 0.35
    }

    center_julia = {
        type       = julia
        position   = vec3(0.0,1.0,0.0)
        radius     = 0.55
        resolution = 32
        power      = 2.0
        bailout    = 8.0
        julia_c    = vec3(-0.12, 0.74, 0.28)
    }
}

material = {
    medium_boundary = {
        type = boundary
    }

    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(1,1,1) }
            }
        }
    }

    wall_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.72,0.72,0.76) }
            }
        }
    }

    light_emissive = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(60.0,60.0,60.0) }
            }
        }
    }

    center_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.62,0.44,0.28) }
            }
        }
    }

    center_emissive = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(24.0,12.0,6.0) }
            }
        }
    }
}

medium = {
    fog_low = {
        type = homogeneous
        sigma_a = col3(0.003,0.004,0.006)
        sigma_s = col3(0.08,0.10,0.14)
        g = 0.02
        emission = col3(0.00,0.00,0.00)
    }

    fog_medium = {
        type = homogeneous
        sigma_a = col3(0.006,0.008,0.012)
        sigma_s = col3(0.18,0.24,0.34)
        g = 0.02
        emission = col3(0.00,0.00,0.00)
    }

    fog_high = {
        type = homogeneous
        sigma_a = col3(0.020,0.028,0.040)
        sigma_s = col3(0.55,0.72,0.98)
        g = 0.02
        emission = col3(0.00,0.00,0.00)
    }

    fog_noise = {
        type = heterogeneous_noise
        sigma_a = col3(0.010,0.014,0.020)
        sigma_s = col3(0.24,0.30,0.40)
        g = 0.02
        emission = col3(0.00,0.00,0.00)
        density = 1
        noise_scale = 4
        noise_min = 0
        noise_max = 1
        octaves = 4
        lacunarity = 50
        gain = 0.1
        seed = 37
    }
}

object = {
    fog_box = {
        geometry = medium_box
        material = medium_boundary
        medium = fog_medium
    }

    floor = { geometry = floor, material = floor_matte }
    top_light = { geometry = top_light, material = light_emissive }
    center = { geometry = center_julia, material = center_matte }
    wall_left = { geometry = wall_left, material = wall_matte }
    wall_right = { geometry = wall_right, material = wall_matte }
    wall_far = { geometry = wall_far, material = wall_matte }
    wall_bottom = { geometry = wall_bottom, material = wall_matte }
}

variants = {
    hide_base = true

    debug = {
        name = Debug Volume
        description = Bright internal read for validating that the fog volume is actually scattering light.
        set = {
            material = {
                light_emissive = {
                    type = emissive
                    properties = {
                        samplers = {
                            emissive = { type = color, value = col3(120.0,120.0,120.0) }
                        }
                    }
                }
            }
            object = {
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_low }
            }
        }
    }

    emissive_center = {
        name = Emissive Center
        description = Makes the internal fractal emissive to verify in-volume glow and local scattering.
        set = {
            object = {
                center = { geometry = center_julia, material = center_emissive }
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_low }
            }
        }
    }

    low = {
        name = Low Fog
        description = Light haze with long visibility through the volume.
        set = {
            object = {
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_low }
            }
        }
    }

    medium = {
        name = Medium Fog
        description = Moderate fog density with readable shafts and retained interior detail.
        set = {
            object = {
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_medium }
            }
        }
    }

    high = {
        name = High Fog
        description = Heavy fog with pronounced extinction while remaining visibly lit.
        set = {
            object = {
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_high }
            }
        }
    }

    noise = {
        name = Noise Fog
        description = Procedural heterogeneous fog with patchy density.
        set = {
            object = {
                fog_box = { geometry = medium_box, material = medium_boundary, medium = fog_noise }
            }
        }
    }
}
