title = Ring Cardioid Caustics
description = Cardioid caustic study with metallic, coated polymer, frosted glass, and sparse volume-filled ring variants.
version     = 1.5
default_camera = default

environment = {
    type = gradient
    config = {
        a = col3(0.92,0.95,1.00)
        b = col3(0.32,0.52,0.90)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 34
        position = vec3(2,5,-2)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
        flength  = 5
        aperture = 0
    }
}

geometry = {
    ground_plane = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        u_scale    = 8
        v_scale    = 8
        modifiers = {
            scale       = vec3(10,1,10)
            rotation    = vec3(0,0,0)
            translation = vec3(0,0,0)
        }
    }

    ring_mirror = {
        type       = mesh
        source     = gen(ring)
        resolution = 100
	radius     = 1.0
	height     = 0.5
        modifiers = {
            scale       = vec3(1,1,1)
            rotation    = vec3(0,0,0)
            translation = vec3(0,0.25,0)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(1,15,10)
        radius   = 8.0
    }
}

material = {   
    ground_plane = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type        = graphpaper
                    base        = col3(0.86,0.86,0.86)
                    minor       = col3(0.45,0.67,0.78)
                    major       = col3(0.10,0.36,0.54)
                    scale       = 10
                    major_every = 5
                    minor_width = 0.045
                    major_width = 0.085
                }
                specular = {
                    type  = color
                    value = col3(0.03,0.03,0.03)
                }
            }
            scalars = {
                exponent    = 40
                reflectance = 0.03
            }
        }
    }

    ring_gold = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(1.0,0.80,0.24) }
                metallic = { type = color, value = col3(1.0,1.0,1.0) }
                roughness = { type = color, value = col3(0.08,0.08,0.08) }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.08
                ior = 1.45
                anisotropy = 0.22
                anisotropy_rotation = 18
                clearcoat = 0.04
                clearcoat_roughness = 0.10
            }
        }
    }

    ring_silver = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.94,0.95,0.98) }
                metallic = { type = color, value = col3(1.0,1.0,1.0) }
                roughness = { type = color, value = col3(0.06,0.06,0.06) }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.06
                ior = 1.45
                anisotropy = 0.18
                anisotropy_rotation = 8
                clearcoat = 0.02
                clearcoat_roughness = 0.08
            }
        }
    }

    ring_bronze = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.82,0.50,0.24) }
                metallic = { type = color, value = col3(1.0,1.0,1.0) }
                roughness = { type = color, value = col3(0.14,0.14,0.14) }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.14
                ior = 1.45
                anisotropy = 0.28
                anisotropy_rotation = 22
                clearcoat = 0.03
                clearcoat_roughness = 0.12
            }
        }
    }

    ring_polymer_clearcoat = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.08,0.12,0.16) }
            }
            scalars = {
                metallic = 0.0
                roughness = 0.42
                ior = 1.52
                clearcoat = 0.95
                clearcoat_roughness = 0.045
            }
        }
    }

    key_light = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(20,20,20)
                }
            }
        }
    }
}

object = {
    ground_plane = {
        geometry = ground_plane
        material = ground_plane
    }

    ring_mirror = {
        geometry = ring_mirror
        material = ring_gold
    }

    key_light = {
        geometry = key_light
        material = key_light
    }
}

variants = {
    hide_base = true
    
    gold = {
        name = Gold
        description = Warm metallic principled ring with a polished gold read.
    }

    silver = {
        name = Silver
        description = Cooler polished silver ring while keeping the same caustic study setup.
        set = {
            object = {
                ring_mirror = {
                    geometry = ring_mirror
                    material = ring_silver
                }
            }
        }
    }

    bronze = {
        name = Bronze
        description = Richer copper-bronze metal with slightly broader highlights and a warmer reflected caustic.
        set = {
            object = {
                ring_mirror = {
                    geometry = ring_mirror
                    material = ring_bronze
                }
            }
        }
    }

    clearcoat_plastic = {
        name = Clear-Coat Plastic
        description = Dark dielectric polymer body with a glossy coated shell for a painted-resin read instead of metal.
        set = {
            object = {
                ring_mirror = {
                    geometry = ring_mirror
                    material = ring_polymer_clearcoat
                }
            }
        }
    }
}
