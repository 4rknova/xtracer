title = Variants Basic Lab
description = Minimal scene to validate variants remove/set overlays.
version = 1.0
default_camera = cam_base

environment = {
  type = color
  config = {
    value = col3(0.04,0.04,0.04)
  }
}

camera = {
  cam_base = {
    type = thin-lens
    fov = 45
    position = vec3(0,1,-6)
    target = vec3(0,0,0)
    up = vec3(0,1,0)
  }
  cam_alt = {
    type = thin-lens
    fov = 55
    position = vec3(2,1,-6)
    target = vec3(0,0,0)
    up = vec3(0,1,0)
  }
}

geometry = {
  ground = {
    type = plane
    normal = vec3(0,1,0)
    distance = -1
  }
  sphere_center = {
    type = sphere
    position = vec3(0,0,0)
    radius = 1
  }
  sphere_right = {
    type = sphere
    position = vec3(2.2,0,0)
    radius = 1
  }
}

material = {
  mat_ground = {
    type = lambert
    properties = {
      samplers = {
        diffuse = { type = color, value = col3(0.5,0.5,0.5) }
      }
    }
  }
  mat_red = {
    type = lambert
    properties = {
      samplers = {
        diffuse = { type = color, value = col3(0.8,0.2,0.2) }
      }
    }
  }
  mat_blue = {
    type = lambert
    properties = {
      samplers = {
        diffuse = { type = color, value = col3(0.2,0.3,0.8) }
      }
    }
  }
}

object = {
  ground = { geometry = ground, material = mat_ground }
  center = { geometry = sphere_center, material = mat_red }
  right = { geometry = sphere_right, material = mat_blue }
}

variants = {
  base = {
    name = Base
    description = Default camera with red center sphere and blue right sphere.
  }

  remove_right = {
    name = Remove Right Sphere
    description = Removes the right sphere object from the scene.
    remove = {
      object = {
        right = {}
      }
    }
  }

  alt_camera_and_blue_center = {
    name = Alt Camera + Blue Center
    description = Switches default camera to cam_alt and changes center sphere to blue.
    set = {
      default_camera = cam_alt
      object = {
        center = { geometry = sphere_center, material = mat_blue }
      }
    }
  }
}
