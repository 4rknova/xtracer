title       = "Alpine Valley"
description = "Mountain landscape with a winding river and Rayleigh atmosphere"
version     = "1.0"
default_camera = hero

environment = {
    type = rayleigh_sky
    config = {
        sun_direction      = vec3(0.42, 0.18, 0.70)
        sun_intensity      = col3(100.0, 100.0, 100.0)
        beta_rayleigh      = col3(0.16, 0.33, 0.78)
        ground_color       = col3(0.06, 0.08, 0.05)
        density            = 0.1
        horizon_falloff    = 1.8
        sun_disk_radius    = 1.0
        sun_disk_intensity = 1.3
        sun_glow_radius    = 10.0
        sun_glow_intensity = 0.38
        sun_glow_falloff   = 3.0
    }
}

camera = {
    hero = {
        type     = thin-lens
        fov      = 45
        position = vec3(-28.0, 20.0, 10.0)
        target   = vec3(0, 0, 4.0)
        up       = vec3(0, 1, 0)
        flength  = 20.0
        aperture = 0.0
    }

    tilt_shift = {
        type     = tilt-shift
        fov      = 58
        position = vec3(-28.0, 12.0, 10.0)
        target   = vec3(0, 0, 4.0)
        up       = vec3(0, 1, 0)
        flength  = 22.0
        aperture = 1.8
        tilt     = 12.0
        shift_x  = 0.0
        shift_y  = 0.0
    }
}

geometry = {
    # Main terrain — near edge starts exactly at camera Z so foreground is fully covered
    # Spans X: -20..20  Y: -2..3  Z: -8..32
    terrain_main = {
        type       = mesh
        source     = gen(terrain)
        resolution = 1024
        dimensions = vec3(200.0, 5.0, 200.0)
        height_sampler = {
            type              = scenery_heightfield
            seed              = 4102
            scale             = 0.26
            octaves           = 6
            lacunarity        = 2.15
            gain              = 0.50
            ridge_strength    = 0.88
            mountain_strength = 0.92
            valley_strength   = 0.62
        }
    }

    water_surface = {
	type       = mesh
        source     = gen(terrain)
        resolution = 256
        dimensions = vec3(200.0, 5.0, 200.0)
        height_sampler = {
            type              = scenery_heightfield
            seed              = 1024
            scale             = 3.
            octaves           = 3
            lacunarity        = 5.00
            gain              = 0.50
            ridge_strength    = 1.0
            mountain_strength = 0.1
            valley_strength   = 0.0
        }
    }
}

material = {
    mountain_rock = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type           = color
                    value          = col3(1,1,1)
                }
            }
            scalars = {
                metallic  = 0.0
                roughness = 0.90
                ior       = 1.5
            }
        }
    }
    
    water = {
        type = rough_dielectric
        properties = {
            samplers = {
                transmission    = { type = color, value = col3(0.78, 0.96, 0.90) }
                absorption_color = { type = color, value = col3(0.08, 0.52, 0.62) }
		gnormal = {
                    type          = voronoi_normal
                    cells         = 10
                    max_deviation = 7.0
                    seed          = 3141
                }
            }
            scalars = {
                ior                 = 1.33
                roughness           = 0.04
                transparency        = 1.0
                absorption_distance = 1.8
            }
        }
    }
}

object = {
    terrain    = { geometry = terrain_main, material = mountain_rock    }
    water      = { geometry = water_surface, material = water           }
}

variants = {
    base = {
        name        = Dawn
        description = Morning sun raking across ridges with clear atmosphere.
    }
}