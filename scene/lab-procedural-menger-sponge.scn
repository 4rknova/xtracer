title = Procedural Menger Sponge Showcase
description = Demonstrates gen(menger_sponge) with adjustable subdivision depth via resolution.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.90,0.93,0.98)
        b = col3(0.10,0.11,0.15)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 44
        position = vec3(0,5,-5)
        target   = vec3(0.0,1.1,1.1)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(25,1,30)
            translation = vec3(0,0,10)
        }
    }

    menger_main = {
        type       = mesh
        source     = gen(menger_sponge)
        resolution = 4
        modifiers = {
            scale       = vec3(2.0,2.0,2.0)
            rotation    = vec3(0,26,0)
            translation = vec3(0.0,1.1,1.2)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(3.2,5.3,-2.0)
        radius   = 0.85
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.56,0.58,0.62) }
            }
        }
    }

    menger_surface = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.67,0.76,0.88) }
                specular = { type = color, value = col3(0.94,0.97,1.00) }
            }
            scalars = {
                exponent    = 92
                reflectance = 0.10
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.0,3.6,3.1) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    menger_main = { geometry = menger_main, material = menger_surface }
    key_light = { geometry = key_light, material = emissive_key }
}
