title = Caustics Integrator Showcase
description = Glass caustics testbed for photon mapping and pathtracer integrators.
version     = 1.0

# Suggested quick presets:
# - integrator: photon_mapping (clear caustic patterns quickly)
# - integrator: pathtracer (reference behavior, converges slower)

environment = {
    type = color
    config = {
        value = col3(0.02,0.02,0.025)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 42
        position = vec3(0.0,3.0,-9.0)
        target   = vec3(0.0,1.1,2.2)
        up       = vec3(0,1,0)
    }

    close = {
        type     = thin-lens
        fov      = 33
        position = vec3(0.8,2.2,-5.8)
        target   = vec3(0.1,0.8,2.4)
        up       = vec3(0,1,0)
    }

    top = {
        type     = thin-lens
        fov      = 36
        position = vec3(0.0,8.0,1.4)
        target   = vec3(0.0,0.0,2.4)
        up       = vec3(0,0,1)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = 0
    }

    back_wall = {
        type   = mesh
        source = gen(plane)
        resolution = 2
        modifiers = {
            scale       = vec3(8,8,8)
            rotation    = vec3(90,0,0)
            translation = vec3(0,4.0,8.5)
        }
    }

    glass_sphere = {
        type     = sphere
        position = vec3(-1.3,1.0,2.4)
        radius   = 1.0
    }

    glass_ball_small = {
        type     = sphere
        position = vec3(1.6,0.62,2.8)
        radius   = 0.62
    }

    glass_octa = {
        type   = mesh
        source = gen(octahedron)
        modifiers = {
            scale       = vec3(1.0,1.0,1.0)
            rotation    = vec3(0,28,0)
            translation = vec3(0.15,1.0,1.2)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(0.0,6.2,1.9)
        radius   = 0.30
    }

    fill_light = {
        type     = sphere
        position = vec3(-3.2,4.2,-0.5)
        radius   = 0.6
    }
}

material = {
    matte_floor = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.78,0.79,0.81)
                }
            }
        }
    }

    matte_wall = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.66,0.69,0.73)
                }
            }
        }
    }

    glass_clear = {
        type = dielectric
        properties = {
            samplers = {}
            scalars = {
                ior          = 1.52
                transparency = 0.97
                reflectance  = 0.03
            }
        }
    }

    glass_warm = {
        type = dielectric
        properties = {
            samplers = {}
            scalars = {
                ior          = 1.46
                transparency = 0.96
                reflectance  = 0.04
            }
        }
    }

    light_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(24.0,21.0,17.0)
                }
            }
        }
    }

    light_fill = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(1.2,1.5,2.2)
                }
            }
        }
    }
}

object = {
    floor = {
        geometry = floor
        material = matte_floor
    }

    back_wall = {
        geometry = back_wall
        material = matte_wall
    }

    glass_sphere = {
        geometry = glass_sphere
        material = glass_clear
    }

    glass_ball_small = {
        geometry = glass_ball_small
        material = glass_warm
    }

    glass_octa = {
        geometry = glass_octa
        material = glass_clear
    }

    key_light = {
        geometry = key_light
        material = light_key
    }

    fill_light = {
        geometry = fill_light
        material = light_fill
    }
}
