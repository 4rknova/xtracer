title = Camera Modes Showcase
description = Same scene framed for thin-lens, ODS, ERP and cubemap camera types.
version     = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.88,0.92,1.00)
        b = col3(0.10,0.14,0.20)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 52
        position = vec3(0.0,2.8,-12.0)
        target   = vec3(0.0,0.4,2.8)
        up       = vec3(0,1,0)
    }

    side = {
        type     = thin-lens
        fov      = 45
        position = vec3(10.0,2.4,1.2)
        target   = vec3(0.0,0.5,2.8)
        up       = vec3(0,1,0)
    }

    top = {
        type     = thin-lens
        fov      = 45
        position = vec3(0.0,12.0,2.5)
        target   = vec3(0.0,0.0,2.8)
        up       = vec3(0,0,1)
    }

    ods = {
        type        = ods
        ipd         = 0.064
        position    = vec3(0.0,1.7,2.8)
        orientation = vec3(0,0,0)
    }

    erp = {
        type        = erp
        position    = vec3(0.0,1.7,2.8)
        orientation = vec3(0,0,0)
    }

    cubemap = {
        type     = cubemap
        position = vec3(0.0,1.7,2.8)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -1.2
    }

    center = {
        type     = sphere
        position = vec3(0.0,0.2,2.8)
        radius   = 1.4
    }

    ring_a = {
        type     = sphere
        position = vec3(-4.2,0.0,2.8)
        radius   = 1.0
    }

    ring_b = {
        type     = sphere
        position = vec3(4.2,0.0,2.8)
        radius   = 1.0
    }

    ring_c = {
        type     = sphere
        position = vec3(0.0,0.0,-1.6)
        radius   = 1.0
    }

    ring_d = {
        type     = sphere
        position = vec3(0.0,0.0,7.2)
        radius   = 1.0
    }

    marker_ico = {
        type   = mesh
        source = gen(icosahedron)
        modifiers = {
            scale       = vec3(0.9,0.9,0.9)
            translation = vec3(-2.2,1.0,5.4)
        }
    }

    marker_octa = {
        type   = mesh
        source = gen(octahedron)
        modifiers = {
            scale       = vec3(0.9,0.9,0.9)
            translation = vec3(2.2,1.0,0.2)
        }
    }

    light = {
        type     = sphere
        position = vec3(-2.0,6.0,-1.0)
        radius   = 0.9
    }
}

material = {
    floor = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.64,0.66,0.70)
                }
            }
        }
    }

    m_center = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.94,0.72,0.30)
                }
                specular = {
                    type  = color
                    value = col3(0.98,0.96,0.88)
                }
            }
            scalars = {
                exponent    = 96
                reflectance = 0.2
            }
        }
    }

    m_a = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.84,0.38,0.34)
                }
                specular = {
                    type  = color
                    value = col3(0.94,0.90,0.90)
                }
            }
            scalars = {
                exponent    = 72
                reflectance = 0.18
            }
        }
    }

    m_b = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.30,0.78,0.56)
                }
                specular = {
                    type  = color
                    value = col3(0.92,0.95,0.93)
                }
            }
            scalars = {
                exponent    = 72
                reflectance = 0.18
            }
        }
    }

    m_c = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.36,0.60,0.95)
                }
                specular = {
                    type  = color
                    value = col3(0.90,0.93,0.98)
                }
            }
            scalars = {
                exponent    = 72
                reflectance = 0.18
            }
        }
    }

    m_d = {
        type = dielectric
        properties = {
            scalars = {
                ior          = 1.5
                transparency = 0.94
                reflectance  = 0.05
            }
        }
    }

    m_marker = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.86,0.88,0.92)
                }
            }
        }
    }

    m_light = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(5.0,4.2,3.4)
                }
            }
        }
    }
}

object = {
    floor = {
        geometry = floor
        material = floor
    }

    center = {
        geometry = center
        material = m_center
    }

    ring_a = {
        geometry = ring_a
        material = m_a
    }

    ring_b = {
        geometry = ring_b
        material = m_b
    }

    ring_c = {
        geometry = ring_c
        material = m_c
    }

    ring_d = {
        geometry = ring_d
        material = m_d
    }

    marker_ico = {
        geometry = marker_ico
        material = m_marker
    }

    marker_octa = {
        geometry = marker_octa
        material = m_marker
    }

    light = {
        geometry = light
        material = m_light
    }
}
