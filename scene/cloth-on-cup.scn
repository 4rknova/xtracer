                base_color = { type = color, value = col3(0.86, 0.78, 0.62) }
            }
            scalars = {
                metallic            = 0.0
                roughness           = 0.08
                ior                 = 1.46
                clearcoat           = 0.3
                clearcoat_roughness = 0.08
            }
