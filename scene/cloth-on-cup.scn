}

object = {
    cloth      = { geometry = cloth,      material = cloth_linen    }
    cup        = { geometry = cup,        material = cup_mat        }
    floor      = { geometry = floor,      material = floor_mat      }
    key_light  = { geometry = key_light,  material = key_light_mat  }
    fill_light = { geometry = fill_light, material = fill_light_mat }
    rim_light  = { geometry = rim_light,  material = rim_light_mat  }
}

variants = {
    linen = {
        name        = Linen
        description = Natural undyed linen — warm sand tones with soft fabric sheen.
    }

    velvet = {
        name        = Velvet
        description = Deep plum velvet — saturated sheen with high nap and rich edge glow.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_velvet }
            }
        }
    }

    silk = {
        name        = Silk
        description = Champagne silk — smooth low-roughness surface with specular sheen.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_silk }
            }
        }
    }

    cotton = {
        name        = Cotton
        description = Off-white cotton — flat matte with fine voronoi surface texture.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_cotton }
            }
        }
    }

    crimson = {
        name        = Crimson
        description = Deep crimson sheen — rich red body with warm edge highlight.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_crimson }
            }
        }
    }

    sage = {
        name        = Sage
        description = Muted sage green sheen — soft earthy fabric tone.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_sage }
            }
        }
    }

    indigo = {
        name        = Indigo
        description = Deep indigo sheen — dark navy body with cool blue edge glow.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_indigo }
            }
        }
    }

    charcoal = {
        name        = Charcoal
        description = Near-black charcoal with subtle cool sheen.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_charcoal }
            }
        }
    }

    weave_natural = {
        name        = Woven Natural
        description = Natural linen weave — tan warp and cream weft at 28 tpi.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_weave_natural }
            }
        }
    }

    weave_cobalt = {
        name        = Woven Cobalt
        description = Navy and cream weave — high contrast two-tone twill.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_weave_cobalt }
            }
        }
    }

    check_red = {
        name        = Red Check
        description = Classic red and ivory checker — tablecloth scale pattern.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_check_red }
            }
        }
    }

    batik = {
        name        = Batik Indigo
        description = Indigo batik — turbulent fbm_marble veins simulate wax-resist dye.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_batik }
            }
        }
    }

    pinstripe = {
        name        = Pinstripe
        description = Dark navy pinstripe — graphpaper grid at fine scale with ivory lines.
        set = {
            object = {
                cloth = { geometry = cloth, material = cloth_pinstripe }
            }
        }
    }
}
