title       = Cloth On Cup
description = Draped linen cloth resting over a ceramic cup, studio-lit for a product-photography feel.
version     = 1.0

environment = {
    type   = gradient
    config = {
        a = col3(0.18, 0.17, 0.16)
        b = col3(0.06, 0.05, 0.05)
    }
}

camera = {
    default = {
        type            = thin-lens
        fov             = 46
        position        = vec3(-5.480368, 3.695577, -2.179567)
        target          = vec3(-0.354712, -0.367524, -0.888682)
        up              = vec3(0, 1, 0)
        flength         = 5.4
        aperture        = 0.04
        aperture_blades = 6
    }

    top = {
        type     = thin-lens
        fov      = 52
        position = vec3(0.0, 5.5, -0.5)
        target   = vec3(-0.2, 0.0, -0.3)
        up       = vec3(0, 0, -1)
    }
}

geometry = {
    cloth = {
        type = meshgroup
        glob = geometry/cloth/plane_001_0*.gltf
    }

    cup = {
        type = meshgroup
        glob = geometry/cloth/sphere_0.gltf
    }

    floor = {
        type     = plane
        normal   = vec3(0, 1, 0)
        distance = -1.0
    }

    key_light = {
        type     = sphere
        position = vec3(-4.0, 5.5, -2.0)
        radius   = 1.0
    }

    fill_light = {
        type     = sphere
        position = vec3(5.5, 2.5, -4.5)
        radius   = 1.4
    }

    rim_light = {
        type     = sphere
        position = vec3(0.5, 5.0, 4.0)
        radius   = 0.5
    }
}

material = {
    cloth_linen = {
        type = sheen
        properties = {
            samplers = {
                base_color  = { type = color, value = col3(0.62, 0.52, 0.44) }
                sheen_color = { type = color, value = col3(0.82, 0.76, 0.70) }
            }
            scalars = {
                sheen     = 0.88
                roughness = 0.72
            }
        }
    }

    cloth_velvet = {
        type = sheen
        properties = {
            samplers = {
                base_color  = { type = color, value = col3(0.18, 0.08, 0.22) }
                sheen_color = { type = color, value = col3(0.52, 0.28, 0.62) }
            }
            scalars = {
                sheen     = 1.0
                roughness = 0.85
            }
        }
    }

    cloth_silk = {
        type = principled
