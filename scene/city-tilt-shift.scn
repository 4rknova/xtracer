title       = "Procedural city"
description = "Procedural city framed with a tilt-shift lens at golden hour for a miniature diorama look."
version     = "1.0"
default_camera = miniature

environment = {
    type = preetham_sky
    config = {
        sun_direction = vec3(0.55,0.28,0.78)
        turbidity     = 3.5
        exposure      = 0.055
        ground_color  = col3(0.10,0.09,0.08)
    }
}

camera = {
    miniature = {
        type              = tilt-shift
        fov               = 60
        position          = vec3(0.802762, 2.860658, -3.866946)
        target            = vec3(0.535964, 1.873911, -2.74749)
        up                = vec3(0,1,0)
        flength           = 4
        aperture          = 0.2
        aperture_blades   = 6
        aperture_rotation = 20
        tilt              = 16
        shift_y           = 0.06
    }

    hero = {
        type     = thin-lens
        fov      = 50
        position = vec3(5.5,4.2,-8.5)
        target   = vec3(0.0,0.4,0.0)
        up       = vec3(0,1,0)
        flength  = 10
        aperture = 0
    }
}

geometry = {
    city = {
        type   = mesh
        source = geometry/city/city.fbx
        modifiers = {
            scale = vec3(0.001,0.001,0.001)
        }
    }

    fill_light = {
        type     = sphere
        position = vec3(-10.0,7.0,-3.0)
        radius   = 1.4
    }
}

material = {
    city_mat = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type  = color
                    value = col3(0.92,0.88,0.82)
                }
            }
            scalars = {
                metallic  = 0.0
                roughness = 0.70
                ior       = 1.45
            }
        }
    }

    fill_light_mat = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(20,20,20)
                }
            }
        }
    }
}

object = {
    city       = { geometry = city,       material = city_mat       }
    fill_light = { geometry = fill_light, material = fill_light_mat }
}
