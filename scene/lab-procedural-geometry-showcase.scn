        set = { object = { subject = { geometry = g_pyramid, material = mat_sandstone } } }
    }

    icosa_cage = {
        name        = Icosahedron Cage
        description = Open wireframe cage based on icosahedron topology.
        set = { object = { subject = { geometry = g_icosa_cage, material = mat_gold } } }
    }

    # ----- New Generators -----

    gear = {
        name        = Gear
