    # Warm sandy stone — pyramid
    mat_sandstone = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.82,0.68,0.46) }
            }
            scalars = { metallic = 0, roughness = 0.80 }
        }
    }

    # Aged bronze — sierpinski_tetrahedron
    mat_bronze = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.72,0.45,0.20) }
            }
            scalars = { metallic = 1, roughness = 0.35 }
        }
    }

    # Dark polished steel — gear
    mat_steel_dark = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.20,0.22,0.26) }
            }
            scalars = { metallic = 1, roughness = 0.08 }
        }
    }

    # Bright spring steel / stainless — spring
    mat_spring_steel = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.88,0.86,0.82) }
            }
            scalars = { metallic = 1, roughness = 0.12 }
        }
    }

    # Nephrite jade — hemisphere
    mat_jade = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.22,0.56,0.36) }
            }
            scalars = { metallic = 0, roughness = 0.18, clearcoat = 0.90, clearcoat_roughness = 0.06 }
        }
    }

    # Warm brushed gold — disc
    mat_warm_gold = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(1.0,0.82,0.36) }
            }
            scalars = { metallic = 1, roughness = 0.30 }
        }
    }

    # Ruby red lacquer — star
    mat_ruby = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.78,0.08,0.10) }
            }
            scalars = { metallic = 0, roughness = 0.10, clearcoat = 1.0, clearcoat_roughness = 0.06 }
        }
    }

    # Iridescent pearl — superellipsoid
    mat_pearl = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.96,0.94,0.92) }
            }
            scalars = { metallic = 0, roughness = 0.05, clearcoat = 1.0, clearcoat_roughness = 0.03 }
        }
    }

    # Amethyst crystal — crystal
    mat_amethyst = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.58,0.26,0.82) }
            }
            scalars = { metallic = 0, roughness = 0.06, clearcoat = 1.0, clearcoat_roughness = 0.04 }
        }
    }

    # Rough bark — tree
    mat_bark = {
        type = principled
        properties = {
            samplers = {
                base_color = {
                    type           = fbm_marble
                    a              = col3(0.30,0.18,0.10)
                    b              = col3(0.20,0.12,0.06)
                    vein           = col3(0.42,0.28,0.14)
                    scale          = 3.0
                    turbulence     = 0.70
                    vein_frequency = 5
                }
            }
            scalars = { metallic = 0, roughness = 0.88 }
        }
    }

    # Warm coral pink — coral
    mat_coral_pink = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.92,0.46,0.36) }
            }
            scalars = { metallic = 0, roughness = 0.55 }
        }
    }

    # Glossy enamel badge generated from an SVG silhouette
    mat_badge_enamel = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.88,0.18,0.14) }
            }
            scalars = { metallic = 0.0, roughness = 0.16, clearcoat = 0.95, clearcoat_roughness = 0.08 }
        }
    }
}

object = {
    floor      = { geometry = floor,          material = mat_floor         }
    fill_light = { geometry = fill_light_geo, material = mat_emissive_fill }
    rim_light  = { geometry = rim_light_geo,  material = mat_emissive_rim  }
    subject    = { geometry = g_icosphere,    material = mat_chrome        }
}

variants = {
    hide_base = true

    # ----- Platonic Solids -----

    tetrahedron = {
        name        = Tetrahedron
        description = Platonic solid: 4 equilateral triangular faces.
        set = { object = { subject = { geometry = g_tetrahedron, material = mat_ceramic } } }
    }

    hexahedron = {
        name        = Hexahedron
        description = Platonic solid: 6 square faces (cube).
        set = { object = { subject = { geometry = g_hexahedron, material = mat_chrome } } }
    }

    octahedron = {
        name        = Octahedron
        description = Platonic solid: 8 equilateral triangular faces.
        set = { object = { subject = { geometry = g_octahedron, material = mat_gold } } }
    }

    dodecahedron = {
        name        = Dodecahedron
        description = Platonic solid: 12 regular pentagonal faces.
        set = { object = { subject = { geometry = g_dodecahedron, material = mat_dark_stone } } }
    }

    icosahedron = {
        name        = Icosahedron
        description = Platonic solid: 20 equilateral triangular faces.
        set = { object = { subject = { geometry = g_icosahedron, material = mat_brushed_steel } } }
    }

    # ----- Smooth / Derived -----

    icosphere = {
        name        = Icosphere
        description = Subdivided icosahedron approximating a smooth sphere.
        set = { object = { subject = { geometry = g_icosphere, material = mat_obsidian } } }
    }

    geodesic_dome = {
        name        = Geodesic Dome
        description = Dome-shaped geodesic triangulated surface.
        set = { object = { subject = { geometry = g_geodesic_dome, material = mat_teal } } }
    }

    plane = {
        name        = Plane Grid
        description = Subdivided rectangular mesh — shown here as a tilted panel.
        set = { object = { subject = { geometry = g_plane_grid, material = mat_marble } } }
    }

    # ----- Cylinders / Rings -----

    cylinder = {
        name        = Cylinder
        description = Open-ended cylindrical surface.
        set = { object = { subject = { geometry = g_cylinder, material = mat_brass } } }
    }

    capped_cylinder = {
        name        = Capped Cylinder
        description = Cylinder with closed flat end caps.
        set = { object = { subject = { geometry = g_capped_cylinder, material = mat_concrete } } }
    }

    cone = {
        name        = Cone
        description = Conical surface tapering to a point.
        set = { object = { subject = { geometry = g_cone, material = mat_orange_plastic } } }
    }

    truncated_cone = {
        name        = Truncated Cone
        description = Frustum — cone with the apex removed.
        set = { object = { subject = { geometry = g_truncated_cone, material = mat_rose_gold } } }
    }

    capsule = {
        name        = Capsule
        description = Cylinder capped with hemispherical ends.
        set = { object = { subject = { geometry = g_capsule, material = mat_ceramic } } }
    }

    torus = {
        name        = Torus
        description = Ring surface — classic donut shape.
        set = { object = { subject = { geometry = g_torus, material = mat_copper } } }
    }

    rounded_ring = {
        name        = Rounded Ring
        description = Torus with a uniform circular cross-section profile.
        set = { object = { subject = { geometry = g_rounded_ring, material = mat_gunmetal } } }
    }

    # ----- Organic / Complex -----

    rock = {
        name        = Rock
        description = Organic procedural rock: fBm-displaced sphere.
        set = { object = { subject = { geometry = g_rock, material = mat_granite } } }
    }

    shell_spiral = {
        name        = Shell Spiral
        description = Logarithmic spiral shell surface.
        set = { object = { subject = { geometry = g_shell_spiral, material = mat_nacre } } }
    }

    chain_link = {
        name        = Chain Link
        description = Interlocking chain of toroidal links.
        set = { object = { subject = { geometry = g_chain_link, material = mat_iron } } }
    }

    tube_curve = {
        name        = Tube Curve
        description = Circular tube swept along Catmull-Rom spline control points.
        set = { object = { subject = { geometry = g_tube_curve, material = mat_tube_curve } } }
    }

    hairball = {
        name        = Hairball
        description = Dense random-fiber hairball geometry.
        set = { object = { subject = { geometry = g_hairball, material = mat_auburn } } }
    }

    lathe = {
        name        = Lathe
        description = Surface of revolution swept from a 2D profile.
        set = { object = { subject = { geometry = g_lathe, material = mat_rose_gold } } }
    }

    draped_cloth_strip = {
        name        = Draped Cloth Strip
        description = Procedural draped and folded fabric strip.
        set = { object = { subject = { geometry = g_cloth_strip, material = mat_silk } } }
    }

    terrain = {
        name        = Terrain
        description = fBm heightfield terrain surface.
        set = { object = { subject = { geometry = g_terrain, material = mat_earth } } }
    }

    # ----- Mathematical -----

    mobius_strip = {
        name        = Mobius Strip
