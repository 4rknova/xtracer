        set = { object = { subject = { geometry = g_gear, material = mat_steel_dark } } }
    }

    spring = {
        name        = Spring
        description = Helical coil spring swept along a helix spine.
        set = { object = { subject = { geometry = g_spring, material = mat_spring_steel } } }
    }

    hemisphere = {
        name        = Hemisphere
        description = Upper half of a sphere with a flat bottom disc cap.
        set = { object = { subject = { geometry = g_hemisphere, material = mat_jade } } }
    }

    disc = {
        name        = Disc
        description = Flat annular disc with configurable inner and outer radii.
        set = { object = { subject = { geometry = g_disc, material = mat_warm_gold } } }
    }

    star = {
        name        = Star
        description = Extruded star polygon with alternating inner and outer radii.
        set = { object = { subject = { geometry = g_star, material = mat_ruby } } }
    }

    superellipsoid = {
        name        = Superellipsoid
        description = Parametric superellipsoid (e1=0.4, e2=0.4) — blocky pillow shape.
        set = { object = { subject = { geometry = g_superellipsoid, material = mat_pearl } } }
    }

    crystal = {
        name        = Crystal Cluster
        description = Cluster of faceted hexagonal prisms with pyramidal tips.
        set = { object = { subject = { geometry = g_crystal, material = mat_amethyst } } }
    }

    tree = {
        name        = Tree
        description = Recursive branching tree built from tapered cylindrical segments.
        set = { object = { subject = { geometry = g_tree, material = mat_bark } } }
    }

    coral = {
        name        = Coral
        description = Organic branching coral colony grown with upward-biased recursion.
        set = { object = { subject = { geometry = g_coral, material = mat_coral_pink } } }
    }

    svg = {
        name        = SVG Mesh
        description = Filled SVG shapes sampled into an extruded mesh; best for icons, badges, and logos.
        set = { object = { subject = { geometry = g_svg, material = mat_badge_enamel } } }
