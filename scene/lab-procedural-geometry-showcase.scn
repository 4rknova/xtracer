title       = Procedural Geometry Showcase
description = Exhaustive reference — one variant per supported procedural generator, principled materials, HDR three-point lighting.
version     = 1.1

environment = {
    type = rayleigh_sky
    config = {
        sun_direction        = vec3(-0.55,0.78,0.30)
        sun_intensity        = col3(10.0,9.0,7.5)
        beta_rayleigh        = col3(0.014,0.035,0.085)
        ground_color         = col3(0.14,0.12,0.10)
        sun_disk_radius      = 0.04
        sun_disk_intensity   = 8.0
        sun_glow_radius      = 0.22
        sun_glow_intensity   = 2.5
        sun_glow_falloff     = 3.5
    }
}

camera = {
    # Main 3/4 hero view
    default = {
        type     = thin-lens
        fov      = 44
        position = vec3(3.5,2.5,-6.5)
        target   = vec3(0,0.2,0)
        up       = vec3(0,1,0)
    }

    # Dramatic low angle looking up
    low_angle = {
        type     = thin-lens
        fov      = 40
        position = vec3(-4.0,0.5,-6.0)
        target   = vec3(0,0.4,0)
        up       = vec3(0,1,0)
    }

    # Elevated 3/4 overview
    high_view = {
        type     = thin-lens
        fov      = 42
        position = vec3(0.5,7.0,-4.5)
        target   = vec3(0,0,0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -2.0
    }

    # Fill: large soft cool sphere, camera-right
    fill_light_geo = {
        type     = sphere
        position = vec3(5.0,3.5,2.0)
        radius   = 2.2
    }

    # Rim: warm accent behind and above subject
    rim_light_geo = {
        type     = sphere
        position = vec3(-0.5,5.0,5.5)
        radius   = 0.9
    }

    # ----- Platonic Solids -----

    g_tetrahedron = {
        type       = mesh
        source     = gen(tetrahedron)
        resolution = 1
        modifiers  = {
            scale    = vec3(1.6,1.6,1.6)
            rotation = vec3(0,28,0)
        }
    }

    g_hexahedron = {
        type       = mesh
        source     = gen(hexahedron)
        resolution = 1
        modifiers  = {
            scale    = vec3(1.4,1.4,1.4)
            rotation = vec3(18,35,8)
        }
    }

    g_octahedron = {
        type       = mesh
        source     = gen(octahedron)
        resolution = 1
        modifiers  = {
            scale    = vec3(1.5,1.5,1.5)
            rotation = vec3(0,22,0)
        }
    }

    g_dodecahedron = {
        type       = mesh
        source     = gen(dodecahedron)
        resolution = 1
        modifiers  = {
            scale    = vec3(1.3,1.3,1.3)
            rotation = vec3(5,18,0)
        }
    }

    g_icosahedron = {
        type       = mesh
        source     = gen(icosahedron)
        resolution = 1
        modifiers  = {
            scale    = vec3(1.4,1.4,1.4)
            rotation = vec3(0,32,0)
        }
    }

    # ----- Smooth / Derived -----

    g_icosphere = {
        type       = mesh
        source     = gen(icosphere)
        resolution = 6
        modifiers  = {
            scale = vec3(1.5,1.5,1.5)
        }
    }

    g_geodesic_dome = {
        type       = mesh
        source     = gen(geodesic_dome)
        resolution = 4
        modifiers  = {
            scale    = vec3(1.8,1.8,1.8)
            rotation = vec3(0,15,0)
        }
    }

    g_plane_grid = {
        type       = mesh
        source     = gen(plane)
        resolution = 32
        modifiers  = {
            scale    = vec3(2.8,2.8,2.8)
            rotation = vec3(-32,18,0)
        }
    }

    # ----- Cylinders / Rings -----

    g_cylinder = {
        type       = mesh
        source     = gen(cylinder)
        resolution = 72
        modifiers  = {
            scale    = vec3(1.0,1.5,1.0)
            rotation = vec3(0,22,0)
        }
    }

    g_capped_cylinder = {
        type       = mesh
        source     = gen(capped_cylinder)
        resolution = 72
        modifiers  = {
            scale    = vec3(1.1,1.4,1.1)
            rotation = vec3(0,18,0)
        }
    }

    g_cone = {
        type       = mesh
        source     = gen(cone)
        resolution = 72
        modifiers  = {
            scale    = vec3(1.2,1.5,1.2)
            rotation = vec3(0,20,0)
        }
    }

    g_truncated_cone = {
        type       = mesh
        source     = gen(truncated_cone)
        resolution = 72
        modifiers  = {
            scale    = vec3(1.2,1.4,1.2)
            rotation = vec3(0,25,0)
        }
    }

    g_capsule = {
        type       = mesh
        source     = gen(capsule)
        resolution = 64
        modifiers  = {
            scale = vec3(1.0,1.2,1.0)
        }
    }

    g_torus = {
        type       = mesh
        source     = gen(ring)
        resolution = 96
        modifiers  = {
            scale    = vec3(1.3,1.3,1.3)
            rotation = vec3(22,30,0)
        }
    }

    g_rounded_ring = {
        type               = mesh
        source             = gen(rounded_ring)
        resolution         = 96
        profile_resolution = 24
        modifiers  = {
            scale    = vec3(1.3,1.3,1.3)
            rotation = vec3(25,20,0)
        }
    }

    # ----- Organic / Complex -----

    g_rock = {
        type       = mesh
        source     = gen(rock)
        resolution = 96
        seed       = 42
        radius     = 1.3
        roughness  = 0.55
        octaves    = 5
        modifiers  = {
            translation = vec3(0,1.3,0)
            rotation    = vec3(0,35,0)
        }
    }

    g_shell_spiral = {
        type        = mesh
        source      = gen(shell_spiral)
        resolution  = 96
        turns       = 4.5
        growth      = 0.24
        tube_radius = 0.18
        modifiers   = {
            translation = vec3(0,0.2,0)
            rotation    = vec3(0,-25,0)
        }
    }

    g_chain_link = {
        type         = mesh
        source       = gen(chain_link)
        resolution   = 72
        count        = 7
        major_radius = 0.55
        minor_radius = 0.14
        spacing      = 1.0
        modifiers    = {
            translation = vec3(0,0.9,0)
            rotation    = vec3(0,15,0)
        }
    }

    g_tube_curve = {
        type               = mesh
        source             = gen(tube_curve)
        resolution         = 128
        profile_resolution = 16
        radius             = 0.08
        closed             = true
        cap_ends           = false
        spline = {
            p0 = vec3(-1.10,0.78,-0.24)
            p1 = vec3(-0.42,1.64,-0.50)
            p2 = vec3(0.58,1.52,-0.12)
            p3 = vec3(1.02,0.72,0.38)
            p4 = vec3(0.18,0.18,0.62)
            p5 = vec3(-0.88,0.38,0.18)
        }
        modifiers = {
            translation = vec3(0,0.08,0)
            rotation    = vec3(0,18,0)
        }
    }

    g_hairball = {
        type       = mesh
        source     = gen(hairball)
        resolution = 64
        seed       = 1337
        radius     = 1.2
        fibers     = 3000
        modifiers  = {
            translation = vec3(0,1.2,0)
            rotation    = vec3(0,20,0)
        }
    }

    g_lathe = {
        type       = mesh
        source     = gen(lathe)
        resolution = 96
        cap_ends   = true
        profile    = {
            p0 = tex2(0.00,-1.00)
            p1 = tex2(0.22,-0.95)
            p2 = tex2(0.42,-0.52)
            p3 = tex2(0.32,-0.08)
            p4 = tex2(0.50, 0.38)
            p5 = tex2(0.20, 0.84)
            p6 = tex2(0.16, 1.00)
        }
        modifiers  = {
            translation = vec3(0,1.0,0)
            rotation    = vec3(0,18,0)
        }
    }

    g_cloth_strip = {
        type       = mesh
        source     = gen(draped_cloth_strip)
        resolution = 96
        dimensions = vec3(2.2,3.2,0.07)
        folds      = 5
        edge_lift  = 0.28
        curl       = 0.22
        taper      = 0.18
        modifiers  = {
            translation = vec3(0,0.2,0)
            rotation    = vec3(0,10,0)
        }
    }

    g_terrain = {
        type       = mesh
        source     = gen(terrain)
        resolution = 128
        dimensions = vec3(4.5,1.4,4.5)
        modifiers  = {
            rotation    = vec3(-30,22,0)
            translation = vec3(0,0.2,0)
        }
    }

    # ----- Mathematical -----

    g_mobius_strip = {
        type       = mesh
        source     = gen(mobius_strip)
        radius     = 1.4
