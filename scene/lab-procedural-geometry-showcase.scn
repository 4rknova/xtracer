title = Procedural Geometry Showcase
description = Demonstrates all in-scene procedural geometry types supported by the parser.
version     = 1.1

environment = {
    type = gradient
    config = {
        a = col3(0.85,0.90,1.00)
        b = col3(0.12,0.16,0.22)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 48
        position = vec3(0,2.5,-14)
        target   = vec3(0,0.5,1.5)
        up       = vec3(0,1,0)
    }

    wide = {
        type     = thin-lens
        fov      = 62
        position = vec3(0,3.2,-20)
        target   = vec3(0,0.7,2.6)
        up       = vec3(0,1,0)
    }

    side = {
        type     = thin-lens
        fov      = 45
        position = vec3(12,2.4,-4.5)
        target   = vec3(0,0.6,3.2)
        up       = vec3(0,1,0)
    }

    top = {
        type     = thin-lens
        fov      = 50
        position = vec3(0,12,-1.5)
        target   = vec3(0,0.0,3.0)
        up       = vec3(0,0,1)
    }

    closeup = {
        type     = thin-lens
        fov      = 40
        position = vec3(1.8,1.6,-6.8)
        target   = vec3(0.2,0.1,3.7)
        up       = vec3(0,1,0)
    }

    erp = {
        type        = erp
        position    = vec3(0,1.6,2.3)
        orientation = vec3(0,0,0)
    }

    cubemap = {
        type     = cubemap
        position = vec3(0,1.6,2.3)
    }
}

geometry = {
    # Procedural primitive: infinite plane
    ground = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -2.2
    }

    # Procedural primitive: sphere
    sphere_a = {
        type     = sphere
        position = vec3(-3.2,-0.9,2.2)
        radius   = 1.3
    }

    # Procedural primitive: point
    point_a = {
        type     = point
        position = vec3(0.0,3.2,-0.8)
    }

    # Procedural primitive: triangle
    tri_a = {
        type = triangle
        vecdata = {
            v0 = vec3(1.4,-2.0,0.8)
            v1 = vec3(4.2,-2.0,2.3)
            v2 = vec3(2.7,0.7,2.0)
        }
    }

    # Procedural mesh generator: gen(icosahedron)
    mesh_ico = {
        type   = mesh
        source = gen(icosahedron)
        modifiers = {
            scale       = vec3(1.5,1.5,1.5)
            rotation    = vec3(0,38,0)
            translation = vec3(0.2,-0.6,3.8)
        }
    }

    # Procedural mesh generator: gen(plane)
    mesh_plane = {
        type       = mesh
        source     = gen(plane)
        resolution = 16
        modifiers = {
            scale       = vec3(2.8,2.8,2.8)
            rotation    = vec3(90,0,0)
            translation = vec3(-0.6,0.0,7.0)
        }
    }

    # Larger visible emissive sphere for stable lighting in low-sample previews
    key_light = {
        type     = sphere
        position = vec3(3.4,3.6,-1.8)
        radius   = 0.7
    }
}

material = {
    matte_ground = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.65,0.66,0.68)
                }
            }
        }
    }

    phong_blue = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.30,0.55,0.95)
                }
                specular = {
                    type  = color
                    value = col3(0.50,0.60,0.80)
                }
            }
            scalars = {
                reflectance = 0.22
                exponent    = 96
            }
        }
    }

    blinn_teal = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.20,0.78,0.70)
                }
                specular = {
                    type  = color
                    value = col3(0.95,0.95,0.95)
                }
            }
            scalars = {
                reflectance = 0.30
                exponent    = 128
            }
        }
    }

    dielectric_glass = {
        type = dielectric
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.96,0.96,1.0)
                }
            }
            scalars = {
                ior         = 1.52
                transparency = 0.92
                reflectance  = 0.10
            }
        }
    }

    emissive_warm = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(4.0,3.2,2.5)
                }
            }
        }
    }
}

object = {
    ground = {
        geometry = ground
        material = matte_ground
    }

    sphere_a = {
        geometry = sphere_a
        material = phong_blue
    }

    point_a = {
        geometry = point_a
        material = emissive_warm
    }

    tri_a = {
        geometry = tri_a
        material = dielectric_glass
    }

    mesh_ico = {
        geometry = mesh_ico
        material = blinn_teal
    }

    mesh_plane = {
        geometry = mesh_plane
        material = matte_ground
    }

    key_light = {
        geometry = key_light
        material = emissive_warm
    }
}
