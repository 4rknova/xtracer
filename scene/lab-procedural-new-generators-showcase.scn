title = New Procedural Generators Showcase
description = Showcases hairball, shell_spiral, rock, chain_link, and lathe generators in one scene.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.86,0.90,0.98)
        b = col3(0.10,0.11,0.14)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 52
        position = vec3(0.0,4.2,-18.5)
        target   = vec3(0.0,1.5,4.0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = 0
    }

    g_hairball = {
        type       = mesh
        source     = gen(hairball)
        resolution = 64
        seed       = 1337
        radius     = 1.15
        fibers     = 3200
        modifiers = {
            translation = vec3(-6.0,1.15,2.5)
            rotation    = vec3(0,30,0)
        }
    }

    g_shell = {
        type        = mesh
        source      = gen(shell_spiral)
        resolution  = 72
        turns       = 4.4
        growth      = 0.24
        tube_radius = 0.18
        modifiers = {
            translation = vec3(-1.8,0.15,3.2)
            rotation    = vec3(0,-20,0)
        }
    }

    g_rock = {
        type       = mesh
        source     = gen(rock)
        resolution = 88
        seed       = 90210
        radius     = 1.2
        roughness  = 0.55
        octaves    = 5
        modifiers = {
            translation = vec3(2.3,1.2,2.7)
            rotation    = vec3(0,18,0)
        }
    }

    g_chain = {
        type         = mesh
        source       = gen(chain_link)
        resolution   = 68
        count        = 8
        major_radius = 0.56
        minor_radius = 0.15
        spacing      = 1.05
        modifiers = {
            translation = vec3(6.3,0.9,2.8)
            rotation    = vec3(0,12,0)
        }
    }

    g_lathe = {
        type       = mesh
        source     = gen(lathe)
        resolution = 96
        cap_ends   = true
        profile = {
            p0 = tex2(0.00,-1.00)
            p1 = tex2(0.24,-0.95)
            p2 = tex2(0.44,-0.55)
            p3 = tex2(0.34,-0.10)
            p4 = tex2(0.52,0.36)
            p5 = tex2(0.22,0.82)
            p6 = tex2(0.18,1.00)
        }
        modifiers = {
            translation = vec3(0.0,1.0,7.4)
            rotation    = vec3(0,16,0)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(0.0,7.4,-0.8)
        radius   = 1.2
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.58,0.60,0.63) }
            }
        }
    }

    mat_hairball = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.74,0.42,0.22) }
            }
        }
    }

    mat_shell = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.70,0.50,0.35) }
                specular = { type = color, value = col3(0.92,0.90,0.85) }
            }
            scalars = {
                exponent    = 96
                reflectance = 0.12
            }
        }
    }

    mat_rock = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.40,0.39,0.37) }
            }
        }
    }

    mat_chain = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse  = { type = color, value = col3(0.64,0.65,0.67) }
                specular = { type = color, value = col3(0.98,0.98,0.98) }
            }
            scalars = {
                exponent    = 132
                reflectance = 0.24
            }
        }
    }

    mat_lathe = {
        type = dielectric
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.96,0.98,1.00) }
            }
            scalars = {
                ior          = 1.50
                transparency = 0.90
                reflectance  = 0.10
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.8,4.0,3.2) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    g_hairball = { geometry = g_hairball, material = mat_hairball }
    g_shell = { geometry = g_shell, material = mat_shell }
    g_rock = { geometry = g_rock, material = mat_rock }
    g_chain = { geometry = g_chain, material = mat_chain }
    g_lathe = { geometry = g_lathe, material = mat_lathe }
    key_light = { geometry = key_light, material = emissive_key }
}
