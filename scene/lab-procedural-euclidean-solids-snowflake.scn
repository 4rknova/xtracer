title = Procedural Euclidean Solids and Snowflake
description = Procedural mesh showcase for platonic solids and Koch snowflake fractal.
version     = 1.3

environment = {
    type = gradient
    config = {
        a = col3(0.90,0.94,1.00)
        b = col3(0.12,0.15,0.21)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 46
        position = vec3(0.0,2.8,-12.5)
        target   = vec3(0.0,0.1,3.2)
        up       = vec3(0,1,0)
    }

    close = {
        type     = thin-lens
        fov      = 42
        position = vec3(-2.0,2.2,-8.2)
        target   = vec3(0.0,0.2,3.0)
        up       = vec3(0,1,0)
    }
}

geometry = {
    ground = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = -1.2
    }

    mesh_tetra = {
        type   = mesh
        source = gen(tetrahedron)
        modifiers = {
            scale       = vec3(1.15,1.15,1.15)
            translation = vec3(-5.0,0.0,3.8)
        }
    }

    mesh_cube = {
        type   = mesh
        source = gen(cube)
        modifiers = {
            scale       = vec3(2.0,2.0,2.0)
            rotation    = vec3(0,26,0)
            translation = vec3(-2.4,0.0,3.8)
        }
    }

    mesh_octa = {
        type   = mesh
        source = gen(octahedron)
        modifiers = {
            scale       = vec3(1.25,1.25,1.25)
            rotation    = vec3(0,24,0)
            translation = vec3(0.0,0.0,3.8)
        }
    }

    mesh_dodeca = {
        type   = mesh
        source = gen(dodecahedron)
        modifiers = {
            scale       = vec3(1.45,1.45,1.45)
            rotation    = vec3(0,20,0)
            translation = vec3(2.8,0.0,3.8)
        }
    }

    mesh_ico = {
        type   = mesh
        source = gen(icosahedron)
        modifiers = {
            scale       = vec3(1.45,1.45,1.45)
            rotation    = vec3(0,18,0)
            translation = vec3(5.5,0.0,3.8)
        }
    }

    mesh_snowflake = {
        type       = mesh
        source     = gen(snowflake)
        resolution = 4
        modifiers = {
            scale       = vec3(3.2,3.2,3.2)
            rotation    = vec3(90,0,0)
            translation = vec3(0.2,-0.2,7.8)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(-2.0,4.0,-1.0)
        radius   = 0.8
    }
}

material = {
    m_ground = {
        type = lambert
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.66,0.67,0.70)
                }
            }
        }
    }

    m_red = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.86,0.34,0.30)
                }
                specular = {
                    type  = color
                    value = col3(0.95,0.90,0.88)
                }
            }
            scalars = {
                reflectance = 0.18
                exponent    = 64
            }
        }
    }

    m_green = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.30,0.78,0.52)
                }
                specular = {
                    type  = color
                    value = col3(0.95,0.96,0.94)
                }
            }
            scalars = {
                reflectance = 0.24
                exponent    = 96
            }
        }
    }

    m_blue = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.36,0.56,0.94)
                }
                specular = {
                    type  = color
                    value = col3(0.86,0.92,0.98)
                }
            }
            scalars = {
                reflectance = 0.22
                exponent    = 80
            }
        }
    }

    m_gold = {
        type = blinn_phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.88,0.70,0.30)
                }
                specular = {
                    type  = color
                    value = col3(0.98,0.94,0.80)
                }
            }
            scalars = {
                reflectance = 0.28
                exponent    = 128
            }
        }
    }

    m_cyan = {
        type = phong
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(0.28,0.82,0.88)
                }
                specular = {
                    type  = color
                    value = col3(0.92,0.96,0.98)
                }
            }
            scalars = {
                reflectance = 0.25
                exponent    = 100
            }
        }
    }

    m_light = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(4.2,3.4,2.7)
                }
            }
        }
    }
}

object = {
    ground = {
        geometry = ground
        material = m_ground
    }

    tetra = {
        geometry = mesh_tetra
        material = m_red
    }

    cube = {
        geometry = mesh_cube
        material = m_green
    }

    octa = {
        geometry = mesh_octa
        material = m_blue
    }

    dodeca = {
        geometry = mesh_dodeca
        material = m_gold
    }

    ico = {
        geometry = mesh_ico
        material = m_cyan
    }

    snowflake = {
        geometry = mesh_snowflake
        material = m_blue
    }

    key_light = {
        geometry = key_light
        material = m_light
    }
}
