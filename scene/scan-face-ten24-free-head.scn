title = Scan Face TEN24 Free Head
descr = 3d scan by TEN24 (http://www.3dscanstore.com/)
versn = 0.1
default_camera = default

path_data     = data
path_geometry = geometry/ten24/Free Head

environment = {
    type = gradient
    config = {
        a = col3(1,1,1)
        b = col3(0.5,0.7,1.0)
    }
}

camera = {
	default = {
	        type = thin-lens
		fov      = 45
		position = vec3(0,0.25,1)
		target   = vec3(0,0.2,0)
		up       = vec3(0,1,0)
	}
}

geometry = {
	sat1 = {
		type = sphere
        radius = 0.1

		position = {
	    		x = 1
			y = 1.5
			z = 1
		}

		intensity = {
			r = 1
			g = 1
			b = 1
		}
	}
}

material = {
    light = {
        type = emissive
        properties = {
            samplers = {
                emissive = {
                    type  = color
                    value = col3(200,200,200)
                }
            }
        }
    }
}

object = {
	head = {
		geometry = head
		material = head
	}

    l0 = {
        geometry = sat1
        material = light
    }

    head = {
        source = <path_geometry>/Head.OBJ
        prefix = head_
    }

    jacket = {
        source = <path_geometry>/Jacket.OBJ
        prefix = jacket_
    }
}
