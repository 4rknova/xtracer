title       = Furnace Dielectric Clear
description = Furnace sanity scene with a clear dielectric sphere in uniform white environment.
version     = 1.0

environment = {
    type = color
    config = {
        value = col3(1.0,1.0,1.0)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 45
        position = vec3(0,0,0)
        target   = vec3(0,0,1)
        up       = vec3(0,1,0)
    }
}

geometry = {
    sphere = {
        type     = sphere
        position = vec3(0,0,3)
        radius   = 1.0
    }
}

material = {
    dielectric_clear = {
        type = dielectric
        properties = {
            samplers = {
                diffuse = {
                    type  = color
                    value = col3(1.0,1.0,1.0)
                }
            }
            scalars = {
                ior          = 1.5
                transparency = 0.98
                reflectance  = 0.04
            }
        }
    }
}

object = {
    sphere = {
        geometry = sphere
        material = dielectric_clear
    }
}
