title = Ring Profile Variants
description = Demonstrates the flat gen(ring) profile alongside the continuous gen(rounded_ring) profile.
version = 1.0
default_camera = hero

environment = {
    type = gradient
    config = {
        a = col3(0.92,0.95,1.00)
        b = col3(0.20,0.28,0.42)
    }
}

camera = {
    hero = {
        type = thin-lens
        position = vec3(1.9,2.3,-2.8)
        target = vec3(0.0,0.35,0.0)
        up = vec3(0,1,0)
        fov = 34
        flength = 5
        aperture = 0
    }
}

geometry = {
    floor = {
        type = mesh
        source = gen(plane)
        resolution = 1
        modifiers = {
            scale = vec3(50,1,50)
            translation = vec3(0,0,0)
        }
    }

    ring_flat = {
        type = mesh
        source = gen(ring)
        resolution = 96
        radius = 1.0
        height = 0.46
        thickness = 0.22
        height_resolution = 3
	modifiers = {
    	    rotation = vec3(0, 0, 0)
    	    scale = vec3(1, 1, 1)
    	    translation = vec3(0, 0.5, 0)
    	}
    }

    ring_rounded = {
        type = mesh
        source = gen(rounded_ring)
        resolution = 96
        radius = 1.0
        height = 0.46
        thickness = 0.22
        profile_resolution = 18
        modifiers = {
            translation = vec3(0, 0.5, 0)
        }
    }

    key_light = {
        type = sphere
        position = vec3(1.2,4.6,2.2)
        radius = 0.5
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.88,0.90,0.94) }
            }
        }
    }

    ring_metal = {
        type = principled
        properties = {
            samplers = {
                base_color = { type = color, value = col3(0.88,0.72,0.30) }
                metallic = { type = color, value = col3(1,1,1) }
                roughness = { type = color, value = col3(0.12,0.12,0.12) }
            }
            scalars = {
                metallic = 1.0
                roughness = 0.12
                anisotropy = 0.18
                anisotropy_rotation = 18
                clearcoat = 0.03
                clearcoat_roughness = 0.08
            }
        }
    }

    light_emissive = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(60,60,60) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    ring = { geometry = ring_flat, material = ring_metal }
    key_light = { geometry = key_light, material = light_emissive }
}

variants = {
    hide_base = true

    flat = {
        name = Flat Ring
        description = Baseline ring with flat top and bottom caps and straight side walls.
    }

    rounded = {
        name = Rounded Ring
        description = Uses a continuous rounded profile instead of the flat ring cross-section.
        set = {
            object = {
                ring = { geometry = ring_rounded, material = ring_metal }
            }
        }
    }
}
