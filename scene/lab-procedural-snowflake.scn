title = Procedural Snowflake Showcase
description = Test scene for gen(snowflake) with configurable iteration depth.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.92,0.96,1.00)
        b = col3(0.12,0.14,0.20)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 40
        position = vec3(0.0,2.4,-4.0)
        target   = vec3(0.0,0.75,0.5)
        up       = vec3(0,1,0)
    }
}

geometry = {
    floor = {
        type     = plane
        normal   = vec3(0,1,0)
        distance = 0
    }

    snowflake_main = {
        type       = mesh
        source     = gen(snowflake)
        resolution = 4
        modifiers = {
            scale       = vec3(1,1,1)
            rotation    = vec3(90,0,0)
            translation = vec3(0.0,0.6,0.5)
        }
    }

    key_light = {
        type     = sphere
        position = vec3(2.8,6.2,-1.6)
        radius   = 0.9
    }
}

material = {
    floor_matte = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.58,0.60,0.64) }
            }
        }
    }

    snowflake_ice = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.92,0.47,0.20) }
            }
        }
    }

    emissive_key = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(4.0,4.0,4.0) }
            }
        }
    }
}

object = {
    floor = { geometry = floor, material = floor_matte }
    snowflake_main = { geometry = snowflake_main, material = snowflake_ice }
    key_light = { geometry = key_light, material = emissive_key }
}
