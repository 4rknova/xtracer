title = Pyramids of Giza Inspired
description = Stylized desert scene with three pyramids inspired by the Giza plateau.
version = 1.0

environment = {
    type = gradient
    config = {
        a = col3(0.95,0.83,0.62)
        b = col3(0.30,0.47,0.74)
    }
}

camera = {
    default = {
        type     = thin-lens
        fov      = 42
        position = vec3(-12.0,5.2,-10.0)
        target   = vec3(0.2,1.2,8.9)
        up       = vec3(0,1,0)
    }

    wide = {
        type     = thin-lens
        fov      = 58
        position = vec3(-16.0,7.0,-14.0)
        target   = vec3(0.5,1.0,9.5)
        up       = vec3(0,1,0)
    }
}

geometry = {
    ground = {
        type       = mesh
        source     = gen(plane)
        resolution = 1
        modifiers = {
            scale       = vec3(120,1,120)
            translation = vec3(0,0,0)
        }
    }

    sun = {
        type     = sphere
        position = vec3(-28,34,-16)
        radius   = 2.5
    }

    # Great pyramid (largest)
    p1 = {
        type      = mesh
        source    = gen(pyramid)
        base_size = 5.6
        height    = 3.2
        modifiers = {
            translation = vec3(0,1.6,7.0)
        }
    }

    # Khafre-inspired pyramid
    p2 = {
        type      = mesh
        source    = gen(pyramid)
        base_size = 4.6
        height    = 2.8
        modifiers = {
            translation = vec3(-4.4,1.4,10.0)
        }
    }

    # Menkaure-inspired pyramid
    p3 = {
        type      = mesh
        source    = gen(pyramid)
        base_size = 3.2
        height    = 1.8
        modifiers = {
            translation = vec3(4.7,0.9,11.4)
        }
    }
}

material = {
    sand_ground = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.84,0.73,0.49) }
            }
        }
    }

    limestone = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.78,0.67,0.45) }
            }
        }
    }

    limestone_dark = {
        type = lambert
        properties = {
            samplers = {
                diffuse = { type = color, value = col3(0.68,0.57,0.40) }
            }
        }
    }

    sun_emissive = {
        type = emissive
        properties = {
            samplers = {
                emissive = { type = color, value = col3(5.0,4.2,3.0) }
            }
        }
    }
}

object = {
    ground = { geometry = ground, material = sand_ground }
    sun = { geometry = sun, material = sun_emissive }

    p1 = { geometry = p1, material = limestone }
    p2 = { geometry = p2, material = limestone_dark }
    p3 = { geometry = p3, material = limestone }
}
